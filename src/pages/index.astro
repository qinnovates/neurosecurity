---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import { HOURGLASS_BANDS, HOURGLASS_WIDTHS } from '../lib/qif-constants';
import HeroParticles from '../components/HeroParticles';
import HourglassReveal from '../components/HourglassReveal';
import ThreatAtlasViz from '../components/ThreatAtlasViz';
import DualUseSplit from '../components/DualUseSplit';
import NeurorightsPentagon from '../components/NeurorightsPentagon';
import '../styles/global.css';
import registry from '@shared/qtara-registrar.json';

// Compute hero metrics from registrar (build-time)
const techniques = (registry as any).techniques ?? [];
const totalThreats = techniques.length;
const therapeuticCount = techniques.filter((t: any) => t?.tara?.clinical?.therapeutic_analog).length;
const dsm5Count = techniques.filter((t: any) => t?.tara?.dsm5?.primary?.length > 0).length;
const confirmed = techniques.filter((t: any) => t.status === 'CONFIRMED').length;
const demonstrated = techniques.filter((t: any) => t.status === 'DEMONSTRATED').length;
const theoretical = techniques.filter((t: any) => ['THEORETICAL', 'EMERGING', 'PLAUSIBLE', 'SPECULATIVE'].includes(t.status)).length;
const neurorightsSet = new Set<string>(['EA']); // Equal Access is structural, not threat-mapped
techniques.forEach((t: any) => (t?.neurorights?.affected ?? []).forEach((r: string) => neurorightsSet.add(r)));
const neurorightsCount = neurorightsSet.size;

// Compute severity breakdown from registrar (build-time)
const bySeverity: Record<string, number> = { critical: 0, high: 0, medium: 0, low: 0 };
techniques.forEach((t: any) => {
  const sev = t.niss?.severity || t.severity || 'low';
  if (bySeverity[sev] !== undefined) bySeverity[sev]++;
});

// Compute neurorights counts from registrar (build-time)
const neurorightsCounts: Record<string, number> = { MI: 0, MP: 0, CL: 0, PC: 0, EA: 0 };
techniques.forEach((t: any) => {
  (t?.neurorights?.affected ?? []).forEach((r: string) => {
    if (neurorightsCounts[r] !== undefined) neurorightsCounts[r]++;
  });
});
---

<BaseLayout title="TARA — Open Threat Catalog for BCI Security" description={`${totalThreats} brain-computer interface attack techniques catalogued in TARA, scored with NISS and mapped to the QIF hourglass architecture. A proposed open framework for an $8B industry.`}>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="relative min-h-screen flex flex-col items-center justify-center px-4 overflow-hidden">
    <!-- Gradient background -->
    <div class="absolute inset-0 bg-[var(--color-bg-deep)]">
      <div class="absolute inset-0 opacity-30" style="background: radial-gradient(ellipse at 50% 30%, rgba(59,130,246,0.15) 0%, transparent 60%), radial-gradient(ellipse at 30% 70%, rgba(6,182,212,0.1) 0%, transparent 50%), radial-gradient(ellipse at 70% 60%, rgba(139,92,246,0.08) 0%, transparent 50%);"></div>
    </div>

    <HeroParticles client:idle />

    <div class="relative z-10 text-center max-w-4xl w-full mx-auto pt-24">
      <p class="text-xs font-medium tracking-[0.2em] uppercase mb-6 hero-byline">
        <strong>Brain-Computer Interface Research by</strong> Kevin L. Qi
      </p>

      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold font-[family-name:var(--font-heading)] tracking-tight mb-6 leading-[1.15]">
        <span class="text-[var(--color-text-primary)]">An Open Threat Catalog</span>
        <br />
        <span class="bg-gradient-to-r from-[var(--color-accent-primary)] via-[var(--color-accent-secondary)] to-[var(--color-accent-tertiary)] bg-clip-text text-transparent">
          for Brain-Computer Interface Security
        </span>
      </h1>

      <p class="text-base sm:text-lg text-[var(--color-text-muted)] mb-10 max-w-2xl mx-auto leading-relaxed">
        TARA maps {totalThreats} BCI attack techniques — scored for neural impact, mapped to the neurorights they threaten, and traced to their therapeutic counterparts. Built on the QIF hourglass architecture for an <a href="/research/landscape/" class="text-[var(--color-accent-primary)] hover:underline">$8 billion industry</a>.*
      </p>

      <!-- Primary CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
        <a
          href="/atlas/tara/"
          class="px-6 py-3 rounded-lg bg-[var(--color-accent-primary)] text-white font-medium hover:bg-[var(--color-accent-primary)]/90 transition-colors"
        >
          Explore the TARA Catalog
        </a>
        <a
          href="/framework/"
          class="px-6 py-3 rounded-lg glass text-[var(--color-text-primary)] font-medium hover:bg-white/10 transition-colors"
        >
          How It's Built
        </a>
      </div>

      <div class="flex flex-wrap items-center justify-center gap-3 mt-6 text-xs" style="color: var(--color-text-faint)">
        <span>Explore by role:</span>
        <a href="/atlas/tara/" class="px-3 py-1.5 rounded-full transition-colors hover:text-[var(--color-text-primary)]" style="background: var(--color-glass-bg); border: 1px solid var(--color-glass-border)">Security Researcher</a>
        <a href="/atlas/clinical/" class="px-3 py-1.5 rounded-full transition-colors hover:text-[var(--color-text-primary)]" style="background: var(--color-glass-bg); border: 1px solid var(--color-glass-border)">Clinician</a>
        <a href="/governance/" class="px-3 py-1.5 rounded-full transition-colors hover:text-[var(--color-text-primary)]" style="background: var(--color-glass-bg); border: 1px solid var(--color-glass-border)">Policymaker</a>
        <a href="/research/api/" class="px-3 py-1.5 rounded-full transition-colors hover:text-[var(--color-text-primary)]" style="background: var(--color-glass-bg); border: 1px solid var(--color-glass-border)">Developer</a>
      </div>

      <p class="text-[10px] text-[var(--color-text-faint)] mt-4">
        *Median estimate across <a href="/research/landscape/" class="underline hover:text-[var(--color-text-muted)] transition-colors">9 market research firms</a>.
      </p>
      <p class="text-[10px] mt-1" style="color: var(--color-text-faint)">{confirmed} confirmed · {demonstrated} demonstrated · {theoretical} theoretical</p>

      <TrustBar />
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
      <svg class="w-5 h-5 text-[var(--color-text-faint)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <!-- ═══ WHAT THIS WORK IS / IS NOT ═══ -->
  <section class="py-16" style="background: var(--color-bg-surface);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6 reveal-stagger reveal">
        <div class="glass rounded-xl p-6">
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-4">What This Work Is</h3>
          <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
            <li>&#8250; Open-source research portfolio</li>
            <li>&#8250; Proposed threat modeling methods</li>
            <li>&#8250; Bridge between security and neurorights</li>
          </ul>
        </div>
        <div class="glass rounded-xl p-6">
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-4">What This Work Is Not</h3>
          <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
            <li>&times; Not a clinical or diagnostic tool</li>
            <li>&times; Not an adopted standard</li>
            <li>&times; Not independently validated</li>
          </ul>
        </div>
      </div>
      <p class="text-center mt-6 font-mono text-xs text-[var(--color-text-faint)] tracking-[0.1em] reveal">PROPOSED &middot; NOT VALIDATED &middot; OPEN TO CRITIQUE</p>
    </div>
  </section>

  <!-- ═══ TARA SNAPSHOT — the flagship showcase ═══ -->
  <section class="relative py-20 px-4 overflow-hidden">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#f97316] mb-3">The TARA Catalog</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-text-primary)] mb-4">
        {totalThreats} techniques. Scored, mapped, and mirrored against a therapeutic use.
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] max-w-2xl mx-auto mb-12">
        Attack techniques catalogued and scored across the QIF hourglass — alongside the same mechanisms as they appear in medicine.
      </p>

      <div class="grid md:grid-cols-2 gap-10 items-center mb-12 text-left">
        <div>
          <ThreatAtlasViz
            client:visible
            total={totalThreats}
            bySeverity={bySeverity}
          />
        </div>
        <div>
          <DualUseSplit
            client:visible
            therapeutic={therapeuticCount}
            siliconOnly={totalThreats - therapeuticCount}
            total={totalThreats}
          />
          <p class="text-sm text-[var(--color-text-muted)] mt-4 text-center">{therapeuticCount} of those same mechanisms are already used in medicine.</p>
        </div>
      </div>

      <!-- One concrete technique -->
      <div class="glass rounded-xl p-6 max-w-2xl mx-auto text-left" style="border-left: 3px solid var(--color-accent-primary);">
        <p class="text-[10px] font-mono tracking-[0.15em] uppercase text-[var(--color-accent-primary)] mb-3">What a BCI attack actually looks like</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-3">
          A brain-computer interface reads motor intent — "move right hand." An attacker intercepts that signal and replays it. The hand moves without the user's intent.
        </p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-3">
          The same mechanism — electrical signal repetition — is used therapeutically in stroke recovery. Same physics. Different intent.
        </p>
        <p class="text-xs text-[var(--color-text-faint)]">
          One of {totalThreats} catalogued techniques. <a href="/atlas/tara/" class="text-[var(--color-accent-primary)] hover:underline">Explore the full catalog &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ VALIDATED, NOT JUST CLAIMED ═══ -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-tertiary)] mb-4 text-center">Validated, Not Just Claimed</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-3 text-center">Does the catalog hold up?</h2>
      <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto mb-8 text-center">
        A catalog that can't be tested is a claim. Here's how it validates against real hardware, real physics, and real neuroscience.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto reveal reveal-stagger">
      <!-- Empirical validation -->
      <a href="/atlas/analysis/t0079-anc-fingerprint/" class="glass rounded-xl p-5 card-hover group text-left">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-[var(--color-accent-primary)]/10 flex items-center justify-center text-[var(--color-accent-primary)]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
          </div>
          <h3 class="text-base font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-primary)] transition-colors">
            Hardware Validation
          </h3>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          28 consumer sensor exploitation techniques validated with real devices. ANC earbuds extract ear canal biometrics at &minus;47 dB below music. No firmware exploit. Just physics.
        </p>
      </a>

      <!-- Endogenous case study -->
      <a href="/atlas/analysis/" class="glass rounded-xl p-5 card-hover group text-left">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-[var(--color-accent-secondary)]/10 flex items-center justify-center text-[var(--color-accent-secondary)]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
          </div>
          <h3 class="text-base font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-secondary)] transition-colors">
            Endogenous Case Study
          </h3>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          The catalog's first test case: COVID + PTSD as a dual-vector endogenous attack chain. Same neural pathways, same failure modes, no device required.
        </p>
      </a>

      <!-- Dual-use discovery -->
      <a href="/atlas/clinical/#therapeutics" class="glass rounded-xl p-5 card-hover group text-left">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-emerald-400/10 flex items-center justify-center text-emerald-400">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
          </div>
          <h3 class="text-base font-semibold font-[family-name:var(--font-heading)] group-hover:text-emerald-400 transition-colors">
            Dual-Use Discovery
          </h3>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          {therapeuticCount} of {totalThreats} attack techniques have direct therapeutic counterparts. The same mechanism that treats Parkinson's can, if misconfigured, cause psychiatric harm.
        </p>
      </a>
    </div>
  </section>

  <!-- ═══ FILLS A REAL GAP ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-secondary)] mb-4 text-center">Fills a Real Gap</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-8 text-center">No BCI-specific threat taxonomy existed</h2>
      <div class="space-y-4 text-sm text-[var(--color-text-muted)] leading-relaxed">
        <div class="grid sm:grid-cols-2 gap-3">
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">FDA</p>
            <p>Requires medical device cybersecurity assessments, but has <strong class="text-[var(--color-text-primary)]">no BCI-specific attack taxonomy</strong>. Guidance says "assess risk per ISO 14971" without defining what BCI threats look like.</p>
          </div>
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">MITRE</p>
            <p>Published a medical device threat modeling playbook (2021), but it is methodology-generic. <strong class="text-[var(--color-text-primary)]">No neural-specific techniques. No BCI entries in ATT&CK.</strong></p>
          </div>
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">CISA</p>
            <p>Created a <a href="https://www.cisa.gov/resources-tools/resources/matrix-game-brain-computer-interfaces" class="text-[var(--color-accent-primary)] hover:underline" target="_blank" rel="noopener noreferrer">tabletop foresight game</a> for BCI futures planning. A board game for brainstorming, not a security framework.</p>
          </div>
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">BCI Manufacturers</p>
            <p>Neuralink, Synchron, Blackrock, Precision Neuroscience: <strong class="text-[var(--color-text-primary)]">zero public security documentation.</strong> No threat models, no vulnerability disclosure policies.</p>
          </div>
        </div>
        <div class="glass rounded-lg p-4" style="border-left: 3px solid var(--color-accent-primary);">
          <p class="font-semibold text-[var(--color-text-primary)] mb-1">What TARA Fills</p>
          <p>{totalThreats} techniques, each scored for neural impact, traced to affected brain regions with {dsm5Count} DSM-5-TR category references (research-based, requiring clinical validation), and mapped to {neurorightsCount} neurorights.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ BUILT ON: THE QIF STACK ═══ -->
  <section class="relative py-20 px-4 overflow-hidden">
    <div class="max-w-3xl mx-auto text-center mb-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-accent-primary)] mb-3">What TARA Is Built On</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-text-primary)] mb-4">
        Every technique maps to the QIF hourglass and a NISS score.
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] max-w-2xl mx-auto">
        QIF is a proposed 11-band architecture — biology above, silicon below, with the physical neural interface at the bottleneck where security either holds or fails. NISS scores each technique by base severity, reversibility, and detectability.
      </p>
    </div>

    <HourglassReveal
      client:visible
      bands={HOURGLASS_BANDS as unknown as any[]}
      widths={HOURGLASS_WIDTHS as unknown as number[]}
    />

    <div class="glass rounded-2xl p-8 max-w-lg mx-auto mt-12 reveal-scale">
      <p class="font-mono text-xs text-[var(--color-text-faint)] mb-4">Example: Signal Injection</p>
      <div class="space-y-4">
        <div><div class="flex justify-between text-xs mb-1"><span class="text-[var(--color-text-muted)]">Base Severity</span><span class="font-mono">6.0</span></div><div class="h-2 rounded-full" style="background: var(--color-bg-elevated);"><div class="h-full rounded-full bg-blue-500" style="width: 60%;"></div></div></div>
        <div><div class="flex justify-between text-xs mb-1"><span class="text-[var(--color-text-muted)]">+ Reversibility</span><span class="font-mono text-amber-500">+1.5</span></div><div class="h-2 rounded-full" style="background: var(--color-bg-elevated);"><div class="h-full rounded-full bg-amber-500" style="width: 15%;"></div></div></div>
        <div><div class="flex justify-between text-xs mb-1"><span class="text-[var(--color-text-muted)]">+ Detectability</span><span class="font-mono text-amber-500">+0.7</span></div><div class="h-2 rounded-full" style="background: var(--color-bg-elevated);"><div class="h-full rounded-full bg-amber-500" style="width: 7%;"></div></div></div>
        <div class="pt-2 border-t" style="border-color: var(--color-border);"><div class="flex justify-between text-sm mb-1"><span class="font-semibold">Final NISS</span><span class="font-mono font-bold text-red-500">8.2 HIGH</span></div><div class="h-3 rounded-full" style="background: var(--color-bg-elevated);"><div class="h-full rounded-full bg-gradient-to-r from-red-500 to-red-400" style="width: 82%;"></div></div></div>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2 mt-8 text-[10px] font-mono text-[var(--color-text-faint)] reveal">
      <span class="glass rounded px-2 py-1">Technique</span><span>&rarr;</span><span class="glass rounded px-2 py-1">Band</span><span>&rarr;</span><span class="glass rounded px-2 py-1">Anatomy</span><span>&rarr;</span><span class="glass rounded px-2 py-1">Function</span><span>&rarr;</span><span class="glass rounded px-2 py-1">NISS</span><span>&rarr;</span><span class="glass rounded px-2 py-1">DSM-5-TR*</span>
    </div>
    <p class="text-center text-[10px] text-[var(--color-text-faint)] mt-2">*Diagnostic category references for threat modeling, not diagnostic claims</p>

    <div class="text-center mt-8">
      <a href="/framework/" class="text-sm text-[var(--color-accent-primary)] hover:text-[var(--color-accent-secondary)] transition-colors">
        Full QIF specification &rarr;
      </a>
    </div>
  </section>

  <!-- ═══ WHAT CONSUMES TARA'S DATA ═══ -->
  <section class="py-20" style="background: var(--color-bg-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-primary)] mb-4">What Consumes TARA's Data</p>
        <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-4">Three proposed specifications, downstream of the catalog</h2>
        <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">Each guardrail reads TARA's technique data and NISS scores to decide what to detect, encrypt, or block — positioned at specific hourglass layers.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto reveal-stagger reveal">
        <a href="/guardrails/" class="glass rounded-xl p-6 card-hover group">
          <div class="flex items-center gap-2 mb-3"><span class="text-amber-500 text-lg">&#9632;</span><span class="font-mono text-[10px] text-[var(--color-text-faint)]">I0</span></div>
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-amber-500 transition-colors">Neurowall</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Signal-layer firewall with blockchain chain-of-evidence at the neural interface boundary.</p>
        </a>
        <a href="/guardrails/nsp/" class="glass rounded-xl p-6 card-hover group">
          <div class="flex items-center gap-2 mb-3"><span class="text-blue-500 text-lg">&#9670;</span><span class="font-mono text-[10px] text-[var(--color-text-faint)]">S1-S2</span></div>
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-blue-500 transition-colors">NSP</h3>
          <p class="text-sm text-[var(--color-text-muted)]">Post-quantum wire protocol securing BCI data links with five defense layers.</p>
        </a>
        <a href="/guardrails/runemate/" class="glass rounded-xl p-6 card-hover group">
          <div class="flex items-center gap-2 mb-3"><span class="text-violet-500 text-lg">&#9650;</span><span class="font-mono text-[10px] text-[var(--color-text-faint)]">S2</span></div>
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-violet-500 transition-colors">Runemate</h3>
          <p class="text-sm text-[var(--color-text-muted)]">On-device policy compiler and content delivery specification for neural interfaces.</p>
        </a>
      </div>
      <p class="text-center mt-6 font-mono text-[10px] text-[var(--color-text-faint)] tracking-[0.1em]">PROPOSED SPECIFICATIONS &middot; NOT PRODUCTION SOFTWARE</p>
    </div>
  </section>

  <!-- ═══ GOVERNANCE & NEURORIGHTS ═══ -->
  <section class="relative py-20 px-4 overflow-hidden">
