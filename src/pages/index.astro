---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import { HOURGLASS_BANDS, HOURGLASS_WIDTHS } from '../lib/qif-constants';
import { NEURORIGHT_COUNT } from '../lib/neurorights-taxonomy';
import SignalBench from '../components/signal-bench/SignalBench';
import { buildSignalBenchEvents } from '../components/signal-bench/signal-bench-events';
import { THREAT_VECTORS } from '../lib/threat-data';
import HourglassReveal from '../components/HourglassReveal';
import AtlasExplorerLink from '../components/brain/AtlasExplorerLink';
import DualUseSplit from '../components/DualUseSplit';
import GliaTeaser from '../components/GliaTeaser.astro';
import NeurorightsRadar from '@/components/radar/NeurorightsRadar';
import '../styles/global.css';
import registry from '@shared/qtara-registrar.json';
import { readNeurorightsTaxonomy, type NeurorightCode } from '@/lib/anatomy/technique-tags';
import { foldNeurorights } from '@/lib/neurorights-fold';
import { CODE_LABELS, METRIC_NAMES, parseNiss } from '../lib/niss-parser';
import { getCatalogCoverage, PURPOSE_SUMMARY, STATEMENT_LINKS } from '../lib/purpose-and-limits';

// Compute hero metrics from registrar (build-time)
const techniques = (registry as any).techniques ?? [];
const totalThreats = techniques.length;
const therapeuticCount = techniques.filter((t: any) => t?.tara?.clinical?.therapeutic_analog).length;
const confirmed = techniques.filter((t: any) => t.status === 'CONFIRMED').length;
const demonstrated = techniques.filter((t: any) => t.status === 'DEMONSTRATED').length;
const theoretical = techniques.filter((t: any) => ['THEORETICAL', 'EMERGING', 'PLAUSIBLE', 'SPECULATIVE'].includes(t.status)).length;

// Labels for the hero signal bench, resolved from the catalog (build-time)
const signalBenchEvents = buildSignalBenchEvents(THREAT_VECTORS);

const coverage = getCatalogCoverage();

// NISS worked example: one catalogued technique with its real metric values and score
const NISS_EXAMPLE_ID = 'QIF-T0001';
const NISS_METRIC_KEYS = ['bi', 'cr', 'cd', 'cv', 'rv', 'np'] as const;
const nissExample = THREAT_VECTORS.find((technique) => technique.id === NISS_EXAMPLE_ID);
if (!nissExample) {
  throw new Error(`Homepage: technique ${NISS_EXAMPLE_ID} is not in the TARA catalog. Update NISS_EXAMPLE_ID in src/pages/index.astro.`);
}
const nissExampleVector = parseNiss(nissExample.niss.vector);
const nissExampleMetrics = NISS_METRIC_KEYS.map((key) => ({
  label: METRIC_NAMES[key],
  value: CODE_LABELS[key][nissExampleVector[key]],
}));

// Compute severity breakdown from registrar (build-time)
const bySeverity: Record<string, number> = { critical: 0, high: 0, medium: 0, low: 0, none: 0 };
techniques.forEach((t: any) => {
  const sev = t.niss?.severity || t.severity || 'low';
  if (bySeverity[sev] !== undefined) bySeverity[sev]++;
});

/*
 * Neurorights counts (build-time). The registrar tags techniques with six
 * codes and states in the glossary that two of them fold in; the fold is read
 * from `folds_into` rather than from the name text, and the chart prints it.
 * The previous count kept MP, CL, MI and PC and dropped DI and IDA silently,
 * which lost every technique that reaches a right only through a folded code.
 */
const neurorightsFold = foldNeurorights(
  readNeurorightsTaxonomy(registry),
  techniques.map((technique: any) => (technique?.neurorights == null ? null : ((technique.neurorights.affected ?? []) as NeurorightCode[]))),
);
---

<BaseLayout title="TARA — Threat Modeling Catalog for Neural Devices · Qinnovate" description={`A proposed, unvalidated framework for threat modeling, severity scoring and impact assessment of neural devices: ${coverage.total} cataloged techniques, ${coverage.scored} with draft NISS scores, ${coverage.detected} with detection guidance.`}>
  <Nav />

  <!-- ═══ HERO: the render, then the goals as the reader scrolls ═══ -->
  <section class="home-hero" aria-labelledby="hero-heading">
    <img class="home-hero-image" src="/images/home-hero.png" alt="A silhouetted head in profile, lit by a blue rim light" width="1672" height="941" fetchpriority="high" />
    <div class="home-hero-scrim" aria-hidden="true"></div>
    <div class="home-hero-copy">
      <h1 id="hero-heading" class="home-hero-title font-[family-name:var(--font-heading)]">Qinnovate</h1>
      <p class="home-hero-sub">An open research effort on the security and governance of brain-computer interfaces.</p>
    </div>
    <div class="home-hero-cue" aria-hidden="true"><span>SCROLL</span><span class="home-hero-cue-line"></span></div>
  </section>

  <section class="home-goals" aria-label="Our goals">
    <div class="home-goal reveal">
      <h2>Where Minds Meet Machines</h2>
      <p>Brain-computer interfaces could change how people communicate, move and learn. We want that future to be safe to enter.</p>
    </div>
    <div class="home-cards">
      <article class="home-card reveal"><span class="home-card-num">01</span><h3>Map the Full Path</h3><p>Trace every layer from silicon hardware to neural tissue.</p></article>
      <article class="home-card reveal"><span class="home-card-num">02</span><h3>Proposed, Not Settled</h3><p>QIF, TARA and NISS are proposed frameworks, open to review and correction.</p></article>
      <article class="home-card reveal"><span class="home-card-num">03</span><h3>Built for Everyone</h3><p>Plain-language explanations and open material so students, clinicians and engineers can all take part.</p></article>
    </div>
    <div class="home-goal reveal">
      <h2>Defend the Person Wearing It</h2>
      <p>Neural data is among the most personal information a person can produce, so its protection should start at design time.</p>
    </div>
    <div class="home-goal reveal">
      <h2>From Silicon to Synapse</h2>
      <p>We map the full path from chip to cortex in the open, so anyone can check our work and challenge it.</p>
      <div class="home-goal-links">
        <a href="/atlas/tara/" class="home-pill home-pill-solid">Explore TARA</a>
        <a href="/framework/" class="home-pill home-pill-ghost">Read the framework</a>
      </div>
    </div>
  </section>

  <!-- ═══ CLOSING CTA ═══ -->
  <section class="border-t border-[var(--color-border)] bg-[var(--color-bg-deep)]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-[var(--spacing-section)] text-center reveal">
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-4">
        The research is open. Start anywhere.
      </h2>
      <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto mb-4">
        Security engineers, neuroscientists, patients, policymakers — the framework is open and ready for review.
      </p>
      <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto mb-8">
        No login, no paywall. Explore the TARA catalog, read the whitepaper, or follow research notes in the <a href="/news/" class="text-[var(--color-accent-primary)] hover:underline">field journal</a>.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/atlas/tara/"
          class="px-8 py-3.5 rounded-lg bg-[var(--color-accent-fill)] text-white font-medium hover:opacity-90 transition-opacity"
        >
          Explore TARA
        </a>
        <a
          href="/governance/"
          class="px-8 py-3.5 rounded-lg glass text-[var(--color-text-primary)] font-medium hover:bg-white/10 transition-colors"
        >
          Explore Governance
        </a>
      </div>

      <div class="mt-8 flex justify-center">
        <GliaTeaser />
      </div>

      <div class="mt-4 text-center">
        <button
          id="copy-bibtex-btn"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-lg text-xs font-medium transition-colors"
          style="background: var(--color-bg-elevated); border: 1px solid var(--color-border); color: var(--color-text-muted)"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
            <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
          </svg>
          Cite this work (BibTeX)
        </button>
      </div>
    </div>
  </section>

  <div class="home-fineprint">
    <p>About this site: QIF, TARA and NISS are proposed research frameworks. They are not validated, not peer-reviewed and not adopted by any standards body. The brain and signal visuals are illustrative, and each pattern shown on the TARA page is labelled with its evidence. Source, data and mappings are public: <a href="https://github.com/qinnovates/neurosecurity">source on GitHub</a> and <a href="/atlas/tara/">the datalake mapping</a>. Privacy choices are in the footer.</p>
  </div>

  <Footer />


  <style>
    .home-hero { position: relative; height: min(88vh, 720px); min-height: 520px; overflow: hidden; background: #000; }
    .home-hero-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center; }
    .home-hero-scrim { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,.25) 0%, rgba(0,0,0,0) 40%, #000 100%); }
    .home-hero-copy { position: absolute; left: 0; right: 0; bottom: 136px; padding: 0 48px; text-align: center; display: flex; flex-direction: column; gap: 14px; align-items: center; }
    .home-hero-title { margin: 0; font-size: clamp(40px, 6vw, 72px); font-weight: 700; color: #fff; letter-spacing: .02em; }
    .home-hero-sub { margin: 0; font-size: clamp(16px, 2vw, 20px); line-height: 1.5; color: #e8e8ee; max-width: 640px; }
    .home-hero-cue { position: absolute; left: 0; right: 0; bottom: 40px; display: flex; flex-direction: column; align-items: center; gap: 10px; color: #c9cdd9; font-size: 12px; letter-spacing: .12em; }
    .home-hero-cue-line { width: 1px; height: 36px; background: rgba(255,255,255,.35); }
    .home-goals { background: #000; padding: 96px 48px; display: flex; flex-direction: column; align-items: center; gap: 56px; }
    .home-goal { max-width: 880px; display: flex; flex-direction: column; gap: 14px; text-align: center; }
    .home-goal h2 { margin: 0; font-size: clamp(32px, 4.5vw, 52px); line-height: 1.1; font-weight: 700; color: #fff; text-wrap: balance; }
    .home-goal p { margin: 0; font-size: 19px; line-height: 1.6; color: #b8bccb; }
    .home-goal-links { display: flex; gap: 14px; flex-wrap: wrap; justify-content: center; margin-top: 8px; }
    .home-cards { display: flex; flex-wrap: wrap; gap: 20px; width: 100%; max-width: 1040px; }
    .home-card { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 12px; padding: 28px; border-radius: 20px; background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.12); }
    .home-card-num { font-size: 12px; letter-spacing: .14em; color: #3d86ff; font-weight: 600; }
    .home-card h3 { margin: 0; font-size: 22px; color: #fff; }
    .home-card p { margin: 0; font-size: 15px; line-height: 1.6; color: #b8bccb; }
    .home-pill { display: inline-flex; align-items: center; min-height: 44px; padding: 0 22px; border-radius: 999px; font-weight: 600; font-size: 14px; }
    .home-pill-solid { background: #1d5fe6; color: #fff; }
    .home-pill-solid:hover { background: #2468f0; }
    .home-pill-ghost { border: 1px solid rgba(255,255,255,.28); color: #e8e8ee; }
    .home-pill-ghost:hover { background: rgba(255,255,255,.08); }
    .home-fineprint { background: #000; padding: 32px 48px 8px; border-top: 1px solid rgba(255,255,255,.08); }
    .home-fineprint p { margin: 0; max-width: 980px; font-size: 12px; line-height: 1.6; color: #82889e; }
    .home-fineprint a { color: #82889e; text-decoration: underline; }
    @supports (animation-timeline: view()) {
      .home-goals .reveal { animation: home-rise linear both; animation-timeline: view(); animation-range: entry 0% cover 30%; }
    }
    @keyframes home-rise { from { opacity: 0; transform: translateY(32px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .home-goals .reveal { animation: none; } }
  </style>
  <style>
    /* Title beside the framing sentence, as on the atlas page, so the picture under them is the first thing on the screen. */
    .brain-hero-head { display: grid; gap: 1rem 3rem; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); align-items: end; }
    .brain-hero-title { margin: 0; font-size: clamp(1.875rem, 3vw, 2.75rem); line-height: 1.08; letter-spacing: -0.015em; }
    .brain-hero-lede { max-width: 44rem; }
    .brain-hero-stage { --brain-hero-height: clamp(20rem, 62vh, 40rem); }
    @media (max-width: 860px) {
      .brain-hero-head { grid-template-columns: minmax(0, 1fr); align-items: start; }
    }
  </style>

  <script>
    document.getElementById('copy-bibtex-btn')?.addEventListener('click', function() {
      const bibtex = '@misc{qinnovate2026qif,\n  author = {{Qinnovate}},\n  title = {QIF: Quantified Interconnection Framework for Brain-Computer Interface Security},\n  year = {2026},\n  doi = {10.5281/zenodo.18640105},\n  url = {https://qinnovate.com},\n  note = {Proposed framework, not yet peer-reviewed}\n}';
      navigator.clipboard.writeText(bibtex).then(() => { this.textContent = 'Copied!'; });
    });
  </script>
</BaseLayout>
