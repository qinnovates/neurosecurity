---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import { HOURGLASS_BANDS, HOURGLASS_WIDTHS } from '../lib/qif-constants';
import SignalBench from '../components/signal-bench/SignalBench';
import { buildSignalBenchEvents } from '../components/signal-bench/signal-bench-events';
import { THREAT_VECTORS } from '../lib/threat-data';
import HourglassReveal from '../components/HourglassReveal';
import ScrollCounter from '../components/ScrollCounter';
import AtlasExplorerLink from '../components/brain/AtlasExplorerLink';
import AtlasIndexPin from '@/components/atlas-scene/AtlasIndexPin.astro';
import BrainHeroMount from '@/components/atlas-scene/BrainHeroMount';
import HeroParticles from '../components/HeroParticles';
import DualUseSplit from '../components/DualUseSplit';
import NeurorightsRadar from '@/components/radar/NeurorightsRadar';
import '../styles/global.css';
import registry from '@shared/qtara-registrar.json';
import { readNeurorightsTaxonomy, type NeurorightCode } from '@/lib/anatomy/technique-tags';
import { foldNeurorights } from '@/lib/neurorights-fold';
import { getCatalogCoverage, PURPOSE_SUMMARY, STATEMENT_LINKS } from '../lib/purpose-and-limits';

// Compute hero metrics from registrar (build-time)
const techniques = (registry as any).techniques ?? [];
const totalThreats = techniques.length;
const therapeuticCount = techniques.filter((t: any) => t?.tara?.clinical?.therapeutic_analog).length;

// Labels for the hero signal bench, resolved from the catalog (build-time)
const signalBenchEvents = buildSignalBenchEvents(THREAT_VECTORS);

const coverage = getCatalogCoverage();

/*
 * Neurorights counts (build-time). The registrar tags techniques with six
 * codes and states in the glossary that two of them fold in; the fold is read
 * from `folds_into` rather than from the name text, and the chart prints it.
 * The previous count kept MP, CL, MI and PC and dropped DI and IDA silently,
 * which lost every technique that reaches a right only through a folded code.
 */
const neurorightsFold = foldNeurorights(
  readNeurorightsTaxonomy(registry),
  techniques.map((technique: any) => (technique?.neurorights == null ? null : ((technique.neurorights.affected ?? []) as NeurorightCode[]))),
);
---

<BaseLayout title="TARA — Threat Modeling Catalog for Neural Devices · Qinnovate" description={`A proposed, unvalidated framework for threat modeling, severity scoring and impact assessment of neural devices: ${coverage.total} cataloged techniques, ${coverage.scored} with draft NISS scores, ${coverage.detected} with detection guidance.`}>
  <Nav />

  <!-- ═══ 1. HERO: orbit-only brain over a revived particle-wave backdrop ═══ -->
  <!--
    Minimal on purpose: the brain is the only subject. It orbits and zooms but
    region-pick is off here (interactive=false) — the full interactive atlas
    lives at /atlas/tara/, linked below. The particle wave is a static backdrop,
    not a second interaction surface.
  -->
  <section class="relative overflow-hidden bg-[var(--color-bg-deep)]" aria-labelledby="hero-heading">
    <AtlasIndexPin />
    <HeroParticles client:load variant="dark" />
    <div class="relative max-w-3xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-10 text-center">
      <p class="text-sm mb-3 hero-byline">Brain-computer interface research by Kevin L. Qi</p>
      <h1 id="hero-heading" class="brain-hero-title font-[family-name:var(--font-heading)] text-balance">
        Threat modeling for brain&#8209;computer interfaces
      </h1>
      <p class="text-sm text-[var(--color-text-faint)] mt-3 max-w-xl mx-auto">
        {coverage.total} techniques, {coverage.scored} with draft NISS scores. Drag to orbit.
      </p>

      <div class="brain-hero-stage mt-7">
        <BrainHeroMount client:load interactive={false} />
        <noscript><p class="text-sm text-[var(--color-text-muted)] mt-3">The 3D brain needs JavaScript. The full atlas, linked below, lists every region as text.</p></noscript>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-center gap-3 mt-7">
        <a
          href="/atlas/tara/"
          class="px-6 py-3 rounded-lg bg-[var(--color-accent-fill)] text-white font-medium text-center hover:opacity-90 transition-opacity"
        >
          Explore the TARA Catalog
        </a>
        <AtlasExplorerLink className="px-6 py-3 rounded-lg glass text-[var(--color-text-primary)] font-medium text-center">Explore the full brain atlas</AtlasExplorerLink>
      </div>

      <div class="mt-8">
        <TrustBar />
      </div>
    </div>
  </section>

  <!-- ═══ 2. SIGNAL DETECTION — plays as it scrolls into view ═══ -->
  <section class="relative py-20 px-4 overflow-hidden" aria-labelledby="signal-heading">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[#f97316] mb-3">Signal Detection</p>
      <h2 id="signal-heading" class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-text-primary)] mb-4">
        {coverage.total} techniques, each with an evidence status
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] max-w-2xl mx-auto mb-10">
        {PURPOSE_SUMMARY} <a href={STATEMENT_LINKS.purposeAndLimits} class="text-[var(--color-accent-primary)] hover:underline">Purpose and limits &rarr;</a>
      </p>

      <div class="flex flex-col min-h-[280px] mb-10 -mx-4 sm:mx-0">
        <SignalBench client:visible events={signalBenchEvents} />
      </div>

      <div class="grid sm:grid-cols-2 gap-8 max-w-2xl mx-auto items-center">
        <div class="text-center">
          <ScrollCounter
            client:visible
            end={totalThreats}
            className="text-5xl sm:text-6xl font-bold font-[family-name:var(--font-heading)] bg-gradient-to-b from-[#f97316] to-[#ef4444] bg-clip-text text-transparent"
          />
          <p class="text-sm text-[var(--color-text-muted)] mt-3">catalogued techniques</p>
        </div>
        <div class="text-center">
          <DualUseSplit
            client:visible
            therapeutic={therapeuticCount}
            siliconOnly={totalThreats - therapeuticCount}
            total={totalThreats}
          />
          <p class="text-xs text-[var(--color-text-muted)] mt-3">{therapeuticCount} have a therapeutic counterpart</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 3. VISUALIZATION TEASERS — a glance, not an embed ═══ -->
  <section class="py-16" style="background: var(--color-bg-surface);" aria-labelledby="viz-heading">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 id="viz-heading" class="sr-only">More ways to see the data</h2>
      <div class="grid md:grid-cols-2 gap-6 reveal-stagger reveal">
        <a href="/framework/" class="glass rounded-xl p-6 card-hover group block">
          <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-primary)] mb-4">The QIF Hourglass</p>
          <HourglassReveal
            client:visible
            bands={HOURGLASS_BANDS as unknown as any[]}
            widths={HOURGLASS_WIDTHS as unknown as number[]}
          />
          <p class="text-sm text-[var(--color-text-muted)] mt-4 group-hover:text-[var(--color-text-primary)] transition-colors">{coverage.total} techniques mapped to an 11-band architecture &rarr;</p>
        </a>
        <a href="/governance/rights/" class="glass rounded-xl p-6 card-hover group block">
          <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[#8b5cf6] mb-4">Neurorights Coverage</p>
          <div class="max-w-xs mx-auto">
            <NeurorightsRadar client:visible fold={neurorightsFold} size={220} />
          </div>
          <p class="text-sm text-[var(--color-text-muted)] mt-4 group-hover:text-[var(--color-text-primary)] transition-colors">Proposed neurorights, mapped against the catalog &rarr;</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 4. NAV CARDS — the only way to the rest of the site ═══ -->
  <section class="py-20 px-4" aria-labelledby="explore-heading">
    <h2 id="explore-heading" class="sr-only">Explore the site</h2>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 max-w-5xl mx-auto reveal-stagger reveal">
      <a href="/atlas/tara/" class="glass rounded-xl p-6 card-hover group">
        <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">Atlas</h3>
        <p class="text-sm text-[var(--color-text-muted)]">{coverage.total} cataloged techniques, scored and mapped to brain anatomy.</p>
      </a>
      <a href="/framework/" class="glass rounded-xl p-6 card-hover group">
        <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">Framework</h3>
        <p class="text-sm text-[var(--color-text-muted)]">The QIF hourglass and the specifications that read its data.</p>
      </a>
      <a href="/research/" class="glass rounded-xl p-6 card-hover group">
        <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">Research</h3>
        <p class="text-sm text-[var(--color-text-muted)]">Whitepaper, papers, the datalake, and the live intel feed.</p>
      </a>
      <a href="/governance/" class="glass rounded-xl p-6 card-hover group">
        <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-2 group-hover:text-[var(--color-accent-primary)] transition-colors">Governance</h3>
        <p class="text-sm text-[var(--color-text-muted)]">Neurorights, ethics, mission, and the derivation log.</p>
      </a>
    </div>
  </section>

  <Footer />

  <style>
    .brain-hero-title { margin: 0; font-size: clamp(1.875rem, 3vw, 2.75rem); line-height: 1.08; letter-spacing: -0.015em; }
    .brain-hero-stage { --brain-hero-height: clamp(20rem, 62vh, 40rem); }
  </style>
</BaseLayout>
