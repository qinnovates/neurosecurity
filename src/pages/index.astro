---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import TrustBar from '../components/TrustBar.astro';
import { HOURGLASS_BANDS, HOURGLASS_WIDTHS } from '../lib/qif-constants';
import SignalBench from '../components/signal-bench/SignalBench';
import { buildSignalBenchEvents } from '../components/signal-bench/signal-bench-events';
import { THREAT_VECTORS } from '../lib/threat-data';
import HourglassReveal from '../components/HourglassReveal';
import AtlasExplorerLink from '../components/brain/AtlasExplorerLink';
import AtlasIndexPin from '@/components/atlas-scene/AtlasIndexPin.astro';
import BrainHeroMount from '@/components/atlas-scene/BrainHeroMount';
import DualUseSplit from '../components/DualUseSplit';
import GliaTeaser from '../components/GliaTeaser.astro';
import NeurorightsRadar from '@/components/radar/NeurorightsRadar';
import '../styles/global.css';
import registry from '@shared/qtara-registrar.json';
import { readNeurorightsTaxonomy, type NeurorightCode } from '@/lib/anatomy/technique-tags';
import { foldNeurorights } from '@/lib/neurorights-fold';
import { CODE_LABELS, METRIC_NAMES, parseNiss } from '../lib/niss-parser';
import { getCatalogCoverage, PURPOSE_SUMMARY, STATEMENT_LINKS } from '../lib/purpose-and-limits';

// Compute hero metrics from registrar (build-time)
const techniques = (registry as any).techniques ?? [];
const totalThreats = techniques.length;
const therapeuticCount = techniques.filter((t: any) => t?.tara?.clinical?.therapeutic_analog).length;
const confirmed = techniques.filter((t: any) => t.status === 'CONFIRMED').length;
const demonstrated = techniques.filter((t: any) => t.status === 'DEMONSTRATED').length;
const theoretical = techniques.filter((t: any) => ['THEORETICAL', 'EMERGING', 'PLAUSIBLE', 'SPECULATIVE'].includes(t.status)).length;

// Labels for the hero signal bench, resolved from the catalog (build-time)
const signalBenchEvents = buildSignalBenchEvents(THREAT_VECTORS);

const coverage = getCatalogCoverage();

// NISS worked example: one catalogued technique with its real metric values and score
const NISS_EXAMPLE_ID = 'QIF-T0001';
const NISS_METRIC_KEYS = ['bi', 'cr', 'cd', 'cv', 'rv', 'np'] as const;
const nissExample = THREAT_VECTORS.find((technique) => technique.id === NISS_EXAMPLE_ID);
if (!nissExample) {
  throw new Error(`Homepage: technique ${NISS_EXAMPLE_ID} is not in the TARA catalog. Update NISS_EXAMPLE_ID in src/pages/index.astro.`);
}
const nissExampleVector = parseNiss(nissExample.niss.vector);
const nissExampleMetrics = NISS_METRIC_KEYS.map((key) => ({
  label: METRIC_NAMES[key],
  value: CODE_LABELS[key][nissExampleVector[key]],
}));

// Compute severity breakdown from registrar (build-time)
const bySeverity: Record<string, number> = { critical: 0, high: 0, medium: 0, low: 0, none: 0 };
techniques.forEach((t: any) => {
  const sev = t.niss?.severity || t.severity || 'low';
  if (bySeverity[sev] !== undefined) bySeverity[sev]++;
});

/*
 * Neurorights counts (build-time). The registrar tags techniques with six
 * codes and states in the glossary that two of them fold in; the fold is read
 * from `folds_into` rather than from the name text, and the chart prints it.
 * The previous count kept MP, CL, MI and PC and dropped DI and IDA silently,
 * which lost every technique that reaches a right only through a folded code.
 */
const neurorightsFold = foldNeurorights(
  readNeurorightsTaxonomy(registry),
  techniques.map((technique: any) => (technique?.neurorights == null ? null : ((technique.neurorights.affected ?? []) as NeurorightCode[]))),
);
---

<BaseLayout title="TARA — Threat Modeling Catalog for Neural Devices · Qinnovate" description={`A proposed, unvalidated framework for threat modeling, severity scoring and impact assessment of neural devices: ${coverage.total} cataloged techniques, ${coverage.scored} with draft NISS scores, ${coverage.detected} with detection guidance.`}>
  <Nav />

  <!-- ═══ HERO: the brain is the first thing on the screen ═══ -->
  <!--
    The 3D brain is this page's subject, so the words above it are a strip and not a column: title beside
    the one-sentence framing, both small enough that the picture sits above the fold. Picking a region in
    the picture shows a short summary beside it with one way on, into the full atlas with that region
    selected; the plain link under the picture reaches the same atlas without the 3D view at all.
  -->
  <section class="relative overflow-hidden bg-[var(--color-bg-deep)]" aria-labelledby="hero-heading">
    <AtlasIndexPin />
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-24 sm:pt-28 pb-10">
      <header class="brain-hero-head">
        <div>
          <p class="text-sm mb-3 hero-byline">Brain-computer interface research by Qinnovate</p>
          <h1 id="hero-heading" class="brain-hero-title font-[family-name:var(--font-heading)] text-balance">
            Threat modeling for brain&#8209;computer interfaces
          </h1>
        </div>
        <div class="brain-hero-lede">
          <p class="text-base text-[var(--color-text-muted)] leading-relaxed">
            A proposed research framework for modeling, scoring and prioritizing threats to neural devices.
          </p>
          <p class="text-sm text-[var(--color-text-faint)] mt-2">
            {coverage.total} cataloged techniques, each with an evidence status. Pick a region to see the risks and devices linked to it.
          </p>
        </div>
      </header>

      <div class="brain-hero-stage mt-7">
        <BrainHeroMount client:load />
        <noscript><p class="text-sm text-[var(--color-text-muted)] mt-3">The 3D brain needs JavaScript. The full atlas, linked below, lists every region as text.</p></noscript>
      </div>

      <!-- The ways on. The atlas link is a plain link on purpose: it reaches every region without the 3D view. -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 mt-7">
        <a
          href="/atlas/tara/"
          class="px-6 py-3 rounded-lg bg-[var(--color-accent-fill)] text-white font-medium text-center hover:opacity-90 transition-opacity"
        >
          Explore the TARA Catalog
        </a>
        <AtlasExplorerLink className="px-6 py-3 rounded-lg glass text-[var(--color-text-primary)] font-medium text-center">Explore the full brain atlas</AtlasExplorerLink>
        <a href="/framework/" class="px-2 py-3 text-sm text-[var(--color-accent-primary)] hover:text-[var(--color-accent-secondary)] transition-colors text-center">
          How it's built &rarr;
        </a>
      </div>

      <div class="mt-10 flex flex-col gap-4">
        <TrustBar />
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs text-[var(--color-text-faint)]">
          <p class="m-0">{demonstrated} demonstrated, {theoretical} theoretical, {confirmed} confirmed with full chain-of-custody.</p>
          <div class="flex flex-wrap items-center gap-2">
            <span class="mr-1">Explore by role:</span>
            <a href="/atlas/tara/" class="glass px-3 py-1.5 rounded-full text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors">Security Researcher</a>
            <a href="/atlas/clinical/" class="glass px-3 py-1.5 rounded-full text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors">Clinician</a>
            <a href="/governance/" class="glass px-3 py-1.5 rounded-full text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors">Policymaker</a>
            <a href="/research/api/" class="glass px-3 py-1.5 rounded-full text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] transition-colors">Developer</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHAT THIS WORK IS / IS NOT ═══ -->
  <section class="py-[var(--spacing-section)]" style="background: var(--color-bg-surface);">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid md:grid-cols-2 gap-6 reveal-stagger reveal">
        <div class="glass rounded-xl p-6">
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-4">What This Work Is</h3>
          <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
            <li>&#8250; Open-source research portfolio</li>
            <li>&#8250; Proposed threat modeling methods</li>
            <li>&#8250; Bridge between security and neurorights</li>
          </ul>
        </div>
        <div class="glass rounded-xl p-6">
          <h3 class="text-lg font-bold font-[family-name:var(--font-heading)] mb-4">What This Work Is Not</h3>
          <ul class="space-y-2 text-sm text-[var(--color-text-muted)]">
            <li>&times; Not a clinical or diagnostic tool</li>
            <li>&times; Not an adopted standard</li>
            <li>&times; Not independently validated</li>
          </ul>
        </div>
      </div>
      <p class="text-center mt-6 font-mono text-xs text-[var(--color-text-faint)] tracking-[0.1em] reveal">PROPOSED &middot; NOT VALIDATED &middot; OPEN TO CRITIQUE</p>
    </div>
  </section>

  <!-- ═══ TARA SNAPSHOT — the flagship showcase ═══ -->
  <section class="relative py-[var(--spacing-section)] px-4 overflow-hidden">
    <div class="max-w-5xl mx-auto text-center">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-accent-primary)] mb-3">The TARA Catalog</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-text-primary)] mb-4">
        Every entry carries an evidence status, not just a name.
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] max-w-2xl mx-auto mb-12">
        {coverage.total} techniques: {coverage.detected} include detection guidance, {coverage.scored} carry draft NISS scores. {PURPOSE_SUMMARY} <a href={STATEMENT_LINKS.purposeAndLimits} class="text-[var(--color-accent-primary)] hover:underline">Purpose and limits &rarr;</a>
      </p>

      <div class="grid md:grid-cols-2 gap-10 items-start mb-12 text-left">
        <div class="text-center">
          <span class="text-6xl sm:text-7xl font-bold font-[family-name:var(--font-heading)] bg-gradient-to-b from-[var(--color-accent-primary)] to-[var(--color-accent-tertiary)] bg-clip-text text-transparent">{totalThreats}</span>
          <p class="text-sm text-[var(--color-text-muted)] mt-4">techniques in the TARA catalog.</p>
          <p class="text-sm mt-2">
            <AtlasExplorerLink className="text-[var(--color-accent-primary)] hover:underline">See the brain regions in the TARA Brain Atlas &rarr;</AtlasExplorerLink>
          </p>
        </div>
        <div>
          <DualUseSplit
            client:visible
            therapeutic={therapeuticCount}
            siliconOnly={totalThreats - therapeuticCount}
            total={totalThreats}
          />
          <p class="text-sm text-[var(--color-text-muted)] mt-4 text-center">{therapeuticCount} of those same mechanisms are already used in medicine.</p>
        </div>
      </div>

      <!-- Signal bench: catalogued interference classes playing out on synthetic traces. Below the fold now, so it draws once seen. -->
      <div class="flex flex-col min-h-[280px] mb-12 -mx-4 sm:mx-0">
        <SignalBench client:visible events={signalBenchEvents} />
      </div>

      <!-- One concrete technique -->
      <div class="glass rounded-xl p-6 max-w-2xl mx-auto text-left" style="border-left: 3px solid var(--color-accent-primary);">
        <p class="text-[10px] font-mono tracking-[0.15em] uppercase text-[var(--color-accent-primary)] mb-3">What a BCI attack actually looks like</p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-3">
          A brain-computer interface reads motor intent — "move right hand." An attacker intercepts that signal and replays it. The hand moves without the user's intent.
        </p>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-3">
          The same mechanism — electrical signal repetition — is used therapeutically in stroke recovery. Same physics. Different intent.
        </p>
        <p class="text-xs text-[var(--color-text-faint)]">
          One of {totalThreats} catalogued techniques. <a href="/atlas/tara/" class="text-[var(--color-accent-primary)] hover:underline">Explore the full catalog &rarr;</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ VALIDATED, NOT JUST CLAIMED ═══ -->
  <section class="py-[var(--spacing-section)]" style="background: var(--color-bg-surface);">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-tertiary)] mb-4 text-center">Validated, Not Just Claimed</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-3 text-center">Does the catalog hold up?</h2>
      <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto mb-8 text-center">
        A catalog that can't be tested is a claim. Here's how it validates against real hardware, real physics, and real neuroscience.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto reveal reveal-stagger">
      <!-- Empirical validation -->
      <a href="/atlas/analysis/t0079-anc-fingerprint/" class="glass rounded-xl p-5 card-hover group text-left">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-[var(--color-accent-primary)]/10 flex items-center justify-center text-[var(--color-accent-primary)]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" /></svg>
          </div>
          <h3 class="text-base font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-primary)] transition-colors">
            Hardware Validation
          </h3>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          28 consumer sensor exploitation techniques validated with real devices. ANC earbuds extract ear canal biometrics at &minus;47 dB below music. No firmware exploit. Just physics.
        </p>
      </a>

      <!-- Endogenous case study -->
      <a href="/atlas/analysis/" class="glass rounded-xl p-5 card-hover group text-left">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-[var(--color-accent-secondary)]/10 flex items-center justify-center text-[var(--color-accent-secondary)]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>
          </div>
          <h3 class="text-base font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-secondary)] transition-colors">
            Endogenous Case Study
          </h3>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          The catalog's first test case: COVID + PTSD as a dual-vector endogenous attack chain. Same neural pathways, same failure modes, no device required.
        </p>
      </a>

      <!-- Dual-use discovery -->
      <a href="/atlas/clinical/#therapeutics" class="glass rounded-xl p-5 card-hover group text-left">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-[var(--color-accent-tertiary)]/10 flex items-center justify-center text-[var(--color-accent-tertiary)]">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21L3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" /></svg>
          </div>
          <h3 class="text-base font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-tertiary)] transition-colors">
            Dual-Use Discovery
          </h3>
        </div>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed">
          {therapeuticCount} of {totalThreats} attack techniques have direct therapeutic counterparts. The same mechanism that treats Parkinson's can, if misconfigured, cause psychiatric harm.
        </p>
      </a>
    </div>
    </div>
  </section>

  <!-- ═══ FILLS A REAL GAP ═══ -->
  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-[var(--spacing-section)]">
    <div class="reveal">
      <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-secondary)] mb-4 text-center">Context</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-8 text-center">Where current device-security guidance stops</h2>
      <div class="space-y-4 text-sm text-[var(--color-text-muted)] leading-relaxed">
        <div class="grid sm:grid-cols-2 gap-3">
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">FDA</p>
            <p>FDA recommends threat modeling for connected medical devices in its premarket cybersecurity guidance (Feb 2026). It does not describe neural-specific threats.</p>
          </div>
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">MITRE</p>
            <p>Published a medical device threat modeling playbook (2021), but it is methodology-generic.</p>
          </div>
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">CISA</p>
            <p>Created a <a href="https://www.cisa.gov/resources-tools/resources/matrix-game-brain-computer-interfaces" class="text-[var(--color-accent-primary)] hover:underline" target="_blank" rel="noopener noreferrer">tabletop foresight game</a> for BCI futures planning.</p>
          </div>
          <div class="glass rounded-lg p-4">
            <p class="font-semibold text-[var(--color-text-primary)] mb-1">BCI Manufacturers</p>
            <p>Neuralink publishes a <a href="https://neuralink.com/vulnerability-disclosure" class="text-[var(--color-accent-primary)] hover:underline" target="_blank" rel="noopener noreferrer">vulnerability disclosure programme</a>. For Synchron, Blackrock Neurotech and Precision Neuroscience, our landscape dataset records <strong class="text-[var(--color-text-primary)]">no published security documentation, threat model or disclosure policy.</strong></p>
          </div>
        </div>
        <div class="glass rounded-lg p-4" style="border-left: 3px solid var(--color-accent-primary);">
          <p class="font-semibold text-[var(--color-text-primary)] mb-1">What TARA proposes</p>
          <p>A catalog of {coverage.total} techniques, {coverage.dsm5Count} with DSM-5-TR category references for threat modeling (not diagnostic claims) — filling the gap the sources above leave open.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ BUILT ON: THE QIF STACK ═══ -->
  <section class="relative py-[var(--spacing-section)] px-4 overflow-hidden" style="background: var(--color-bg-surface);">
    <div class="max-w-3xl mx-auto text-center mb-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-[var(--color-accent-primary)] mb-3">What TARA Is Built On</p>
      <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-text-primary)] mb-4">
        Every technique maps to one band of the hourglass.
      </h2>
      <p class="text-sm text-[var(--color-text-muted)] max-w-2xl mx-auto">
        QIF is a proposed 11-band architecture — biology above, silicon below, with the physical neural interface at the bottleneck where security either holds or fails. NISS scores a technique on {nissExampleMetrics.length} metrics; the example below shows them for one catalogued technique.
      </p>
    </div>

    <HourglassReveal
      client:visible
      bands={HOURGLASS_BANDS as unknown as any[]}
      widths={HOURGLASS_WIDTHS as unknown as number[]}
    />

    <div class="glass rounded-2xl p-8 max-w-lg mx-auto mt-12 reveal-scale">
      <p class="font-mono text-xs text-[var(--color-text-faint)] mb-4">
        Example: <a href={`/atlas/tara/${nissExample.id}/`} class="hover:underline">{nissExample.id}</a> {nissExample.name}
      </p>
      <dl class="space-y-2 text-xs">
        {nissExampleMetrics.map((metric) => (
          <div class="flex justify-between gap-4">
            <dt class="text-[var(--color-text-muted)]">{metric.label}</dt>
            <dd class="font-mono">{metric.value}</dd>
          </div>
        ))}
      </dl>
      <div class="pt-3 mt-4 border-t" style="border-color: var(--color-border);">
        <div class="flex justify-between text-sm mb-1">
          <span class="font-semibold">NISS score</span>
          <span class="font-mono font-bold">{nissExample.niss.score.toFixed(1)} {nissExample.niss.severity}</span>
        </div>
        <div class="h-3 rounded-full" style="background: var(--color-bg-elevated);">
          <div class="score-build-fill h-full rounded-full bg-[var(--color-accent-primary)]" style={`width: ${nissExample.niss.score * 10}%;`}></div>
        </div>
      </div>
    </div>
    <div class="flex flex-wrap items-center justify-center gap-2 mt-8 text-[10px] font-mono text-[var(--color-text-faint)] reveal">
      <span class="chain-step glass rounded px-2 py-1" style="--chain-step: 0;">Technique</span><span>&rarr;</span><span class="chain-step glass rounded px-2 py-1" style="--chain-step: 1;">Band</span><span>&rarr;</span><span class="chain-step glass rounded px-2 py-1" style="--chain-step: 2;">Anatomy</span><span>&rarr;</span><span class="chain-step glass rounded px-2 py-1" style="--chain-step: 3;">Function</span><span>&rarr;</span><span class="chain-step glass rounded px-2 py-1" style="--chain-step: 4;">NISS</span><span>&rarr;</span><span class="chain-step glass rounded px-2 py-1" style="--chain-step: 5;">DSM-5-TR*</span>
    </div>
    <p class="text-center text-[10px] text-[var(--color-text-faint)] mt-2">*Diagnostic category references for threat modeling, not diagnostic claims</p>

    <div class="text-center mt-8">
      <a href="/framework/" class="text-sm text-[var(--color-accent-primary)] hover:text-[var(--color-accent-secondary)] transition-colors">
        Full QIF specification &rarr;
      </a>
    </div>
  </section>

  <!-- ═══ WHAT CONSUMES TARA'S DATA ═══ -->
  <section class="py-[var(--spacing-section)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12 reveal">
        <p class="text-xs font-semibold tracking-[0.15em] uppercase text-[var(--color-accent-primary)] mb-4">Future Work</p>
        <h2 class="text-2xl sm:text-3xl font-bold font-[family-name:var(--font-heading)] mb-4">Three specifications planned to build on the catalog</h2>
        <p class="text-[var(--color-text-muted)] max-w-2xl mx-auto">Each planned guardrail would read TARA's technique data and NISS scores to decide what to detect, encrypt, or block — positioned at specific hourglass layers. None of this is built yet.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-4 max-w-4xl mx-auto reveal-stagger reveal">
        <a href="/guardrails/" class="glass rounded-xl p-6 card-hover group">
          <div class="flex items-center gap-2 mb-3"><span class="text-[var(--color-accent-primary)] text-lg">&#9632;</span><span class="font-mono text-[10px] text-[var(--color-text-faint)]">I0</span></div>
