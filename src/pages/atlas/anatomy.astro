---
import ToolLayout from '@/layouts/ToolLayout.astro';
import AtlasExplorer from '@/components/atlas-scene/AtlasExplorer';
import { loadAnatomyBundle } from '@/components/atlas-scene/load-anatomy-data';

// The page is built with no anatomy in it: only the index's path, length and digest, so the
// explorer can refuse an index from any other build. It fetches this site's own static files
// when it starts and parses each one before showing any of it.
const { indexPin } = loadAnatomyBundle();
---
<ToolLayout
  title="TARA Brain Atlas"
  description="Explore the brain regions, device stages and attack techniques of the TARA catalog as text: what each region is drawn through, what is linked to it, and what the data cannot tell you."
>
  <!--
    The brain is this page's subject, so the words above it are a strip and not a column: title
    beside the caveats, both small enough that the picture is the first thing on the screen. Every
    sentence that was here is still here.
  -->
  <header class="atlas-page-head">
    <h1 class="atlas-page-title">TARA Brain Atlas</h1>
    <p class="atlas-page-note">
      Brain regions, the device stages beside them, and the attack techniques of the TARA catalog, a proposed catalog that has not been peer reviewed.
      An AI drafted every link between them and no expert has checked it. Each part says what it cannot tell you.
    </p>
  </header>
  <!-- Rendered in the browser only: the page carries no anatomy, so there is nothing to render at build time. -->
  <AtlasExplorer client:only="react" indexPin={indexPin} />
  <noscript><p>This explorer needs JavaScript. It runs entirely in your browser and reads only this site's own data files.</p></noscript>
</ToolLayout>

<style>
  .atlas-page-head {
    display: grid;
    gap: 0.25rem 1.5rem;
    grid-template-columns: minmax(0, auto) minmax(0, 1fr);
    align-items: baseline;
    margin-bottom: 0.875rem;
  }
  .atlas-page-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-text-primary);
  }
  .atlas-page-note {
    margin: 0;
    max-width: 68ch;
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--color-text-muted);
  }
  @media (max-width: 860px) {
    .atlas-page-head { grid-template-columns: minmax(0, 1fr); }
  }
</style>
