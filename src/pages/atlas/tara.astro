---
import PageLayout from '@/layouts/PageLayout.astro';
import AtlasViewSwitcher from '@/components/atlas/AtlasViewSwitcher.astro';
import BciKql from '@/components/bci/BciKql';
import { getKqlTables } from '@/lib/kql-tables';
import { HOURGLASS_BANDS } from '@/lib/qif-constants';
import { THREAT_CATEGORIES, THREAT_VECTORS } from '@/lib/threat-data';
import TaraVisualization from '@/components/TaraVisualization';
import TaraExplorer from '@/components/tara-gui/TaraExplorer.astro';
import AtlasIndexPin from '@/components/atlas-scene/AtlasIndexPin.astro';
import { getCatalogCoverage } from '@/lib/purpose-and-limits';

const kqlTables = getKqlTables();
const coverage = getCatalogCoverage();
const bands = [...HOURGLASS_BANDS];
const categories = [...THREAT_CATEGORIES];
---

<PageLayout
  title="TARA Atlas — Threat Catalog"
  description={`${coverage.total} techniques in a proposed threat catalog for neural-device threat modeling, each with an evidence status.`}
  breadcrumbs={[{ label: 'Atlas', href: '/atlas/' }, { label: 'TARA' }]}
  wide={true}
>
  <AtlasViewSwitcher current="/atlas/tara/" />
  <div id="tara-command-center" class="min-h-screen -mt-4 pt-4">
    <div class="max-w-[1400px] mx-auto">
      <AtlasIndexPin />
      <TaraExplorer />
      <div class="mb-12">
        <div class="mt-8">
          <TaraVisualization 
            client:only="react" 
            threats={THREAT_VECTORS} 
            categories={categories} 
            bands={bands} 
          />
        </div>

        <!-- KQL Query Engine -->
        <div class="mt-16">
          <div class="flex items-center gap-3 mb-6">
            <div class="flex-1 h-px" style="background: var(--color-border);" />
            <span class="text-[10px] uppercase tracking-[0.12em] font-mono" style="color: var(--color-text-faint);">Query Engine</span>
            <div class="flex-1 h-px" style="background: var(--color-border);" />
          </div>
          <BciKql client:only="react" tables={{}} />
        </div>

        <div class="mt-32 pt-16 border-t border-slate-100 max-w-5xl">
            <h2 class="text-3xl font-semibold tracking-tight text-slate-900 mb-6">API & Adoption</h2>
            <p class="text-lg text-slate-500 font-medium leading-relaxed mb-8">
                The TARA Atlas is designed to be integrated into security platforms, research pipelines, and BCI firmware. Use the STIX 2.1 feed or the raw JSON endpoints. (The qtara Python SDK is deprecated.)
            </p>
            <a href="/research/api/" class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-slate-900 text-white text-sm font-semibold hover:bg-slate-800 transition-colors">
                APIs, Feeds & SDKs
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
            </a>
        </div>
      </div>
    </div>
  </div>
</PageLayout>
