---
import PageLayout from '@/layouts/PageLayout.astro';
import AtlasViewSwitcher from '@/components/atlas/AtlasViewSwitcher.astro';
import TaraExplorer from '@/components/atlas/TaraExplorer';
import { CATALOG_VERSION, THREAT_VECTORS, getStatusStats, getNeurorightStats } from '@/lib/threat-data';
import { getCatalogCoverage } from '@/lib/purpose-and-limits';

const coverage = getCatalogCoverage();
const statusStats = getStatusStats();
const nrStats = getNeurorightStats();

// 2026-10 redesign: this is now the single primary "browse the threats" page.
// It replaces the separate /atlas/ hub (8-card nav wall) and /atlas/explorer/
// (a second, disconnected search+filter table) — both now redirect here.
// TaraVisualization's own view-mode/sort taxonomy and the inline raw-KQL
// console are retired from this page: TaraExplorer is the one catalog UI,
// and query access lives at /data-studio/, which already owns that job.
---

<PageLayout
  title="TARA Atlas — Threat Catalog"
  description={`${coverage.total} techniques in a proposed threat catalog for neural-device threat modeling, each with an evidence status.`}
  breadcrumbs={[{ label: 'Atlas', href: '/atlas/tara/' }, { label: 'TARA' }]}
  wide={true}
>
  <AtlasViewSwitcher current="/atlas/tara/" />
  <div class="min-h-screen -mt-4 pt-4">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-10">
        <div class="flex items-center gap-3 mb-4">
          <span class="text-[11px] font-semibold text-[var(--color-text-faint)] uppercase tracking-widest">TARA catalog v{CATALOG_VERSION}</span>
          <span class="w-1 h-1 rounded-full" style="background: var(--color-text-faint);"></span>
          <span class="text-[11px] font-semibold text-amber-500 uppercase tracking-widest">Proposed</span>
        </div>
        <h1 class="text-4xl sm:text-5xl font-semibold tracking-tight mb-4" style="color: var(--color-text-primary);">
          The TARA Atlas
        </h1>
        <p class="text-lg text-[var(--color-text-muted)] leading-relaxed max-w-2xl mb-6">
          {coverage.total} techniques, each with an evidence status. {coverage.detected} include detection guidance; {coverage.scored} carry draft NISS scores.
        </p>
        <div class="flex flex-wrap gap-6 text-sm text-[var(--color-text-muted)]">
          <span><strong style="color: var(--color-text-primary);">{statusStats.CONFIRMED + statusStats.DEMONSTRATED}</strong> demonstrated or confirmed</span>
          <span><strong style="color: var(--color-text-primary);">{nrStats.withNeurorights}/{THREAT_VECTORS.length}</strong> mapped to a neurorights (of 5)</span>
          <a href="/atlas/chains/" class="text-[var(--color-accent-primary)] hover:underline">See a technique in a kill chain &rarr;</a>
          <a href="/atlas/tara/coverage-gaps/" class="text-[var(--color-accent-primary)] hover:underline">Entries without detection guidance &rarr;</a>
        </div>
      </div>

      <TaraExplorer client:load techniques={THREAT_VECTORS} />

      <div class="mt-16 pt-10 border-t max-w-3xl" style="border-color: var(--color-border);">
        <h2 class="text-xl font-semibold mb-3" style="color: var(--color-text-primary);">API & Adoption</h2>
        <p class="text-sm text-[var(--color-text-muted)] leading-relaxed mb-4">
          This catalog is designed to be integrated into security platforms, research pipelines, and BCI firmware. Use the STIX 2.1 feed or the raw JSON endpoints. (The qtara Python SDK is deprecated.) To query the full dataset directly, use <a href="/data-studio/" class="text-[var(--color-accent-primary)] hover:underline">Data Studio</a>.
        </p>
        <a href="/research/api/" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg text-sm font-medium" style="background: var(--color-accent-fill); color: #fff;">
          APIs, Feeds & SDKs &rarr;
        </a>
      </div>
    </div>
  </div>
</PageLayout>
