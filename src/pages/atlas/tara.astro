---
import PageLayout from '@/layouts/PageLayout.astro';
import AtlasViewSwitcher from '@/components/atlas/AtlasViewSwitcher.astro';
import AtlasIndexPin from '@/components/atlas-scene/AtlasIndexPin.astro';
import atlas from '@shared/qif-brain-bci-atlas.json';
import TaraExplorer from '@/components/tara/TaraExplorer';
import { buildSearchIndex } from '@/components/tara/search-index';
import { HOURGLASS_BANDS } from '@/lib/qif-constants';
import { CATALOG_VERSION, THREAT_VECTORS } from '@/lib/threat-data';
import '@/components/tara/tara.css';

const regions = atlas.brain_regions.map(({ id, name }) => ({ id, name }));
const index = buildSearchIndex(THREAT_VECTORS, regions, HOURGLASS_BANDS);
const cards = [
  { title: 'Threat story, step by step', href: '/atlas/chains/', text: 'Follow the connections between threats and defensive controls.' },
  { title: 'Threat library', href: '/atlas/tara/ttps/', text: `Browse ${THREAT_VECTORS.length} public techniques and their evidence status.` },
  { title: 'Why believe this?', href: '/atlas/scoring/', text: 'Understand the scoring methodology and its limitations.' },
];
---
<PageLayout title="TARA Glia by Qinnovate" description="Threat Analysis Risk Atlas for the neural frontier." breadcrumbs={[{ label: 'Atlas', href: '/atlas/' }, { label: 'TARA' }]} wide>
  <AtlasViewSwitcher current="/atlas/tara/" />
  <article class="tara-page">
    <AtlasIndexPin />
    <TaraExplorer client:load index={index} catalogVersion={CATALOG_VERSION} />
    <noscript><p>Explore region names and mappings in the <a href="/atlas/explorer/">full atlas</a>. The interactive brain and search require JavaScript.</p></noscript>
    <div class="tara-caption"><p>Defensive threat modelling. Placement is AI-drafted, unreviewed. Scores are Draft.</p><a href="/atlas/attribution/">Atlas sources & attribution ↗</a></div>
    <div class="tara-cards">{cards.map((card) => <a class="tara-card" href={card.href}><h2>{card.title} <span aria-hidden="true">↗</span></h2><p>{card.text}</p></a>)}</div>
    <footer class="tara-footer"><p>A research atlas for asking better questions about neural-device safety. Not a compliance claim.</p><a class="tara-pill tara-primary" href="/atlas/explorer/">Open full atlas ↗</a></footer>
  </article>
</PageLayout>
