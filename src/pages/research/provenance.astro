---
import PageLayout from '@/layouts/PageLayout.astro';
import {
  getTrackedFigures,
  getCanonicalReference,
  getDecisionRecord,
  getIntakeSummary,
} from '@/lib/provenance';

const figures = getTrackedFigures();
const reference = getCanonicalReference();
const record = getDecisionRecord();
const intake = getIntakeSummary();

const sections = [
  { href: '#figures', label: 'Tracked Figures' },
  { href: '#canonical', label: 'Canonical Reference' },
  { href: '#decisions', label: 'Decision Record' },
  { href: '#intake', label: 'Research Intake' },
];

function formatDate(value: string | null): string {
  if (!value) return 'not stated';
  const match = value.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (!match) return value;
  const date = new Date(`${match[0]}T00:00:00`);
  return date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}
---

<PageLayout
  title="Data Provenance"
  description="Every figure this site publishes, the file it is derived from, and the date it was last verified — plus the research intake ledger of proposals that have not been published."
  breadcrumbs={[{ label: 'Research', href: '/research/' }, { label: 'Data Provenance' }]}
  wide
>
  <div class="lg:grid lg:grid-cols-[14rem_1fr] lg:gap-12">
    <!-- Section nav -->
    <aside class="hidden lg:block">
      <nav class="sticky top-24">
        <p class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-faint)] mb-3">On this page</p>
        {sections.map((section) => (
          <a
            href={section.href}
            class="block text-sm py-1.5 text-[var(--color-text-muted)] hover:text-[var(--color-accent-primary)] transition-colors border-l-2 border-transparent hover:border-[var(--color-accent-primary)] pl-3"
          >
            {section.label}
          </a>
        ))}
      </nav>
    </aside>

    <div class="max-w-3xl">
      <!-- Overview -->
      <section class="mb-16">
        <h1 class="text-3xl sm:text-4xl font-bold font-[family-name:var(--font-heading)] mb-4">
          Data Provenance
        </h1>
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="text-xs font-semibold px-3 py-1 rounded-full border border-[var(--color-accent-primary)] text-[var(--color-accent-primary)]">
            Figures as of {formatDate(figures.asOf)}
          </span>
          <span class="text-xs font-semibold px-3 py-1 rounded-full border border-[var(--color-text-faint)]/30 text-[var(--color-text-faint)]">
            {figures.scriptDerivedCount} script-derived &middot; {figures.manualCount} maintained by hand
          </span>
        </div>
        <div class="prose">
          <p class="text-lg text-[var(--color-text-muted)]">
            Every count and version number on this site comes from a file in the repository, not from
            prose. This page lists all of them in one place, says which file each one is read from, and
            says plainly which ones a script re-derives and which ones a person maintains by hand.
          </p>
          <p>
            The figures are read from <code>{figures.timelineSource}</code> at build time. Running
            <code>{figures.checkCommand}</code> re-derives the script-checked fields from their source
            data and reports any that have gone stale. A figure with no machine-readable source is
            listed as maintained by hand rather than presented as verified.
          </p>
          <p>
            QIF, NISS, TARA and NSP are proposed and unvalidated. Nothing here has been adopted by a
            standards body or independently peer-reviewed. A figure being traceable says where it came
            from; it does not say the framework it describes has been validated. See
            <a href="/research/validation/">Validation Status</a> for what has and has not been tested.
          </p>
        </div>
      </section>

      <!-- Tracked figures -->
      <section id="figures" class="mb-16">
        <h2 class="text-2xl font-bold font-[family-name:var(--font-heading)] mb-6">Tracked Figures</h2>
        <div class="prose mb-6">
          <p>
            All figures carry the same <code>as_of</code> date, {formatDate(figures.asOf)} — the date the
            set was last reconciled as a whole. Fields marked <strong>script</strong> are re-derived from
            the listed file by <code>{figures.checkCommand}</code>; fields marked <strong>by hand</strong>
            are not, so they can drift between refreshes.
          </p>
        </div>

        <h3 class="text-sm font-semibold mb-3 text-[var(--color-text-primary)]">Counts</h3>
        <div class="glass rounded-xl p-5 mb-8 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-[var(--color-border)]">
                <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Figure</th>
                <th class="py-2 px-3 text-right font-semibold text-xs text-[var(--color-text-faint)]">Value</th>
                <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Derived from</th>
                <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Checked</th>
              </tr>
            </thead>
            <tbody>
              {figures.counts.map((figure) => (
                <tr class="border-b border-[var(--color-border)]/50">
                  <td class="py-2.5 px-3 text-[var(--color-text-primary)]">{figure.label}</td>
                  <td class="py-2.5 px-3 text-right font-[family-name:var(--font-mono)] text-[var(--color-accent-primary)]">{figure.value}</td>
                  <td class="py-2.5 px-3 font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-muted)] break-all">
                    {figure.source ?? <span class="text-[var(--color-text-faint)]">no single source recorded</span>}
                  </td>
                  <td class="py-2.5 px-3 text-xs whitespace-nowrap">
                    {figure.scriptDerived
                      ? <span class="text-[var(--color-status-safe)]">script</span>
                      : <span class="text-[var(--color-status-warn)]">by hand</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <h3 class="text-sm font-semibold mb-3 text-[var(--color-text-primary)]">Versions</h3>
        <div class="glass rounded-xl p-5 mb-6 overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-[var(--color-border)]">
                <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Component</th>
                <th class="py-2 px-3 text-right font-semibold text-xs text-[var(--color-text-faint)]">Version</th>
                <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Declared in</th>
                <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Checked</th>
              </tr>
            </thead>
            <tbody>
              {figures.versions.map((figure) => (
                <tr class="border-b border-[var(--color-border)]/50">
                  <td class="py-2.5 px-3 text-[var(--color-text-primary)]">{figure.label}</td>
                  <td class="py-2.5 px-3 text-right font-[family-name:var(--font-mono)] text-[var(--color-accent-secondary)]">{figure.value}</td>
                  <td class="py-2.5 px-3 font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-muted)] break-all">
                    {figure.source ?? <span class="text-[var(--color-text-faint)]">no single source recorded</span>}
                  </td>
                  <td class="py-2.5 px-3 text-xs whitespace-nowrap">
                    {figure.scriptDerived
                      ? <span class="text-[var(--color-status-safe)]">script</span>
                      : <span class="text-[var(--color-status-warn)]">by hand</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="glass rounded-xl p-5" style="border-left: 3px solid var(--color-status-warn);">
          <h3 class="text-sm font-semibold mb-2">What "by hand" means</h3>
          <p class="text-sm text-[var(--color-text-muted)]">
            {figures.manualCount} of the tracked figures have no script that recomputes them from a
            source file. They were correct when they were written down and are reviewed during a data
            refresh, but between refreshes nothing detects if they have gone stale. They are listed here
            with that caveat rather than left off the page.
          </p>
        </div>
      </section>

      <!-- Canonical reference -->
      <section id="canonical" class="mb-16">
        <h2 class="text-2xl font-bold font-[family-name:var(--font-heading)] mb-6">Canonical Reference</h2>
        <div class="prose mb-6">
          <p>
            Equations, values and definitions have one canonical home:
            <code>{reference.path}</code>. Where a blog post, whitepaper section or dataset disagrees
            with it, that file is the one to trust and the others are the ones to fix.
          </p>
        </div>

        <a
          href={reference.url}
          target="_blank"
          rel="noopener noreferrer"
          class="glass rounded-xl p-6 block group mb-4 border-l-4 border-[var(--color-accent-primary)]"
        >
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <h3 class="text-lg font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-secondary)] transition-colors">
              QIF Source of Truth
            </h3>
            {reference.documentVersion && (
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full border border-[var(--color-accent-primary)]/40 text-[var(--color-accent-primary)]">
                v{reference.documentVersion}
              </span>
            )}
          </div>
          <dl class="grid sm:grid-cols-3 gap-4 text-sm mb-4">
            <div>
              <dt class="text-xs text-[var(--color-text-faint)]">Last updated</dt>
              <dd class="text-[var(--color-text-primary)]">{formatDate(reference.lastUpdated)}</dd>
            </div>
            <div>
              <dt class="text-xs text-[var(--color-text-faint)]">Last full validation</dt>
              <dd class="text-[var(--color-text-primary)]">{formatDate(reference.lastValidated)}</dd>
            </div>
            <div>
              <dt class="text-xs text-[var(--color-text-faint)]">Sections</dt>
              <dd class="text-[var(--color-text-primary)]">{reference.sections.length}</dd>
            </div>
          </dl>
          <span class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-accent-secondary)]">&rarr; Read the full reference on GitHub</span>
        </a>

        {reference.auditNote && (
          <div class="glass rounded-xl p-5 mb-4" style="border-left: 3px solid var(--color-status-warn);">
            <h3 class="text-sm font-semibold mb-2">The document's own audit note</h3>
            <p class="text-sm text-[var(--color-text-muted)]">{reference.auditNote}</p>
          </div>
        )}

        {reference.taraCurrentStateComputed && (
          <div class="glass rounded-xl p-5 mb-6">
            <h3 class="text-sm font-semibold mb-2">TARA registry current state</h3>
            <p class="text-sm text-[var(--color-text-muted)] mb-3">
              The reference's TARA current-state section states: last computed
              {' '}{reference.taraCurrentStateComputed}. The same unscored-technique and severity-field
              gaps are published on <a href="/atlas/scoring/#coverage" class="text-[var(--color-accent-primary)] hover:underline">the NISS coverage section</a>.
            </p>
            <a
              href={`${reference.url}${reference.taraCurrentStateAnchor}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-accent-secondary)] hover:underline"
            >&rarr; Jump to that section</a>
          </div>
        )}

        <details class="glass rounded-xl p-5">
          <summary class="text-sm font-semibold cursor-pointer">What the reference covers</summary>
          <ul class="mt-3 space-y-1 text-sm text-[var(--color-text-muted)]">
            {reference.sections.map((section) => <li>{section}</li>)}
          </ul>
        </details>
      </section>

      <!-- Decision record -->
      <section id="decisions" class="mb-16">
        <h2 class="text-2xl font-bold font-[family-name:var(--font-heading)] mb-6">Decision Record</h2>
        <div class="prose mb-6">
          <p>
            When a published figure or claim changes, the reasoning is appended to the derivation log
            rather than quietly edited into place. The log is append-only, which means it also records
            the corrections — including where a previously published claim was found to be wrong.
          </p>
        </div>

        <a
          href={record.url}
          target="_blank"
          rel="noopener noreferrer"
          class="glass rounded-xl p-6 block group mb-4 border-l-4 border-[var(--color-accent-tertiary)]"
        >
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <h3 class="text-lg font-semibold font-[family-name:var(--font-heading)] group-hover:text-[var(--color-accent-secondary)] transition-colors">
              QIF Derivation Log
            </h3>
            <span class="text-xs font-semibold px-2 py-0.5 rounded-full border border-[var(--color-accent-tertiary)]/40 text-[var(--color-accent-tertiary)]">
              {record.entryCount} entries
            </span>
          </div>
          <p class="text-sm text-[var(--color-text-muted)] mb-2">
            <code>{record.path}</code>
          </p>
          <span class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-accent-secondary)]">&rarr; Read the full log on GitHub</span>
        </a>

        {record.latest && (
          <div class="glass rounded-xl p-5">
            <h3 class="text-sm font-semibold mb-2">Most recent entry</h3>
            <p class="text-sm text-[var(--color-text-muted)] mb-3">
              <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-primary)]">Entry {record.latest.number}</span>
              {' — '}{record.latest.title}
            </p>
            <a
              href={record.latest.url}
              target="_blank"
              rel="noopener noreferrer"
              class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-accent-secondary)] hover:underline"
            >&rarr; Read Entry {record.latest.number}</a>
          </div>
        )}

        <p class="text-sm text-[var(--color-text-muted)] mt-4">
          The log also feeds the generated
          <a href="/governance/" class="text-[var(--color-accent-primary)] hover:underline">governance decision and transparency records</a>,
          and the <a href="/news/derivation/" class="text-[var(--color-accent-primary)] hover:underline">derivation log directory</a>
          lists the companion field journal and tool logs.
        </p>
      </section>

      <!-- Research intake -->
      <section id="intake" class="mb-16">
        <h2 class="text-2xl font-bold font-[family-name:var(--font-heading)] mb-6">Research Intake</h2>

        <div class="glass rounded-xl p-5 mb-6" style="border-left: 3px solid var(--color-status-warn);">
          <h3 class="text-sm font-semibold mb-2">Intake items are proposals, not published data</h3>
          <p class="text-sm text-[var(--color-text-muted)]">
            Nothing counted in this section is part of the datasets the rest of the site reads. A data
            refresh gathers candidate changes; each one is a proposal until its disposition is
            <code>accepted</code> and it has been merged into the dataset it targets. The figures in
            <a href="#figures" class="text-[var(--color-accent-primary)] hover:underline">Tracked Figures</a>
            above reflect the published datasets only.
          </p>
        </div>

        <div class="prose mb-6">
          <p>{intake.description}</p>
          <p>
            Dispositions in use: <code>{intake.dispositions.join(', ')}</code>.
          </p>
        </div>

        {intake.batches.map((batch) => (
          <div class="mb-10">
            <h3 class="text-lg font-semibold font-[family-name:var(--font-heading)] mb-4">
              Batch {batch.batch}
            </h3>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
              <div class="glass rounded-xl p-4 text-center">
                <div class="text-2xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-accent-primary)]">{batch.gathered}</div>
                <div class="text-xs text-[var(--color-text-faint)] mt-1">Items gathered</div>
              </div>
              <div class="glass rounded-xl p-4 text-center">
                <div class="text-2xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-status-safe)]">{batch.published}</div>
                <div class="text-xs text-[var(--color-text-faint)] mt-1">Verified &amp; published in the ledger</div>
              </div>
              <div class="glass rounded-xl p-4 text-center">
                <div class="text-2xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-status-warn)]">{batch.held}</div>
                <div class="text-xs text-[var(--color-text-faint)] mt-1">Held back</div>
              </div>
              <div class="glass rounded-xl p-4 text-center">
                <div class="text-2xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-accent-secondary)]">{batch.sourcesCollected}</div>
                <div class="text-xs text-[var(--color-text-faint)] mt-1">Sources collected</div>
              </div>
            </div>

            <div class="glass rounded-xl p-5 mb-6 overflow-x-auto">
              <h4 class="text-sm font-semibold mb-3">Per collector</h4>
              <table class="w-full text-sm">
                <thead>
                  <tr class="border-b border-[var(--color-border)]">
                    <th class="py-2 px-3 text-left font-semibold text-xs text-[var(--color-text-faint)]">Collector</th>
                    <th class="py-2 px-3 text-right font-semibold text-xs text-[var(--color-text-faint)]">Gathered</th>
                    <th class="py-2 px-3 text-right font-semibold text-xs text-[var(--color-text-faint)]">Published</th>
                    <th class="py-2 px-3 text-right font-semibold text-xs text-[var(--color-text-faint)]">Held</th>
                  </tr>
                </thead>
                <tbody>
                  {batch.artifacts.map((artifact) => (
                    <tr class="border-b border-[var(--color-border)]/50">
                      <td class="py-2.5 px-3 font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-primary)]">{artifact.artifact}</td>
                      <td class="py-2.5 px-3 text-right font-[family-name:var(--font-mono)]">{artifact.gathered}</td>
                      <td class="py-2.5 px-3 text-right font-[family-name:var(--font-mono)] text-[var(--color-status-safe)]">{artifact.published}</td>
                      <td class="py-2.5 px-3 text-right font-[family-name:var(--font-mono)] text-[var(--color-status-warn)]">{artifact.held}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="glass rounded-xl p-5 mb-6">
              <h4 class="text-sm font-semibold mb-2">Why {batch.held} items are held back</h4>
              <p class="text-sm text-[var(--color-text-muted)] mb-3">
                Each held item is one the collecting agent could not confirm against a source it had
                actually fetched. The ledger records that they exist and how many there are, but not what
                they assert: {batch.withheldFileCount} raw collector files are withheld for that reason.
              </p>
              <p class="text-sm text-[var(--color-text-muted)]">{batch.heldReason}</p>
              <p class="text-xs text-[var(--color-text-faint)] mt-3">
                An unconfirmed claim about a named company is not published here, not as a hedge and not
                as a quotation. The claim text stays out of the ledger until it is verified or dropped.
              </p>
            </div>

            {batch.review && (
              <div class="glass rounded-xl p-5 mb-6" style="border-left: 3px solid var(--color-accent-tertiary);">
                <h4 class="text-sm font-semibold mb-2">Independent review, {formatDate(batch.review.reviewed)}</h4>
                <p class="text-sm text-[var(--color-text-muted)] mb-4">{batch.review.method}</p>

                <p class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-faint)] mb-2">Item verdicts</p>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-5">
                  {batch.review.verdicts.map((verdict) => (
                    <div class="rounded-lg p-3 text-center" style="background: var(--color-bg-secondary); border: 1px solid var(--color-border);">
                      <div class="text-xl font-bold font-[family-name:var(--font-heading)] text-[var(--color-text-primary)]">{verdict.count}</div>
                      <div class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-text-faint)] mt-1 break-all">{verdict.verdict}</div>
                    </div>
                  ))}
                </div>

                <dl class="space-y-3 text-sm">
                  <div>
                    <dt class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-faint)] mb-1">Citations</dt>
                    <dd class="text-[var(--color-text-muted)]">{batch.review.citations}</dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-faint)] mb-1">
                      Statements contradicted ({batch.review.blockedStatementCount})
                    </dt>
                    <dd class="text-[var(--color-text-muted)]">
                      {batch.review.blockedStatementNote}
                      {' '}The contradicted statements themselves are not reproduced here; the ledger
                      carries the verdict against each one.
                    </dd>
                  </div>
                  <div>
                    <dt class="text-xs font-semibold tracking-wider uppercase text-[var(--color-text-faint)] mb-1">What the review did not re-check</dt>
                    <dd class="text-[var(--color-text-muted)]">{batch.review.coverageGaps}</dd>
                  </div>
                </dl>
              </div>
            )}

            <div class="glass rounded-xl p-5">
              <h4 class="text-sm font-semibold mb-3">Batch record</h4>
              <dl class="space-y-2 text-sm">
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-xs text-[var(--color-text-faint)] shrink-0 sm:w-48">Collected</dt>
                  <dd class="text-[var(--color-text-muted)]">{formatDate(batch.collected)}</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-xs text-[var(--color-text-faint)] shrink-0 sm:w-48">Baseline compared against</dt>
                  <dd class="text-[var(--color-text-muted)]">{batch.baseline}</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-xs text-[var(--color-text-faint)] shrink-0 sm:w-48">Raw files published</dt>
                  <dd class="text-[var(--color-text-muted)]">{batch.rawFileCount}</dd>
                </div>
                <div class="flex flex-col sm:flex-row sm:gap-4">
                  <dt class="text-xs text-[var(--color-text-faint)] shrink-0 sm:w-48">Site inconsistencies found</dt>
                  <dd class="text-[var(--color-text-muted)]">{batch.siteInconsistenciesFound}</dd>
                </div>
              </dl>
            </div>
          </div>
        ))}

        <div class="glass rounded-xl p-5">
          <h3 class="text-sm font-semibold mb-3">Disposition of every item the ledger publishes</h3>
          <ul class="space-y-1 text-sm text-[var(--color-text-muted)] mb-4">
            {intake.itemDispositions.map((disposition) => (
              <li>
                <span class="font-[family-name:var(--font-mono)] text-xs text-[var(--color-text-primary)]">{disposition.verdict}</span>
                {' — '}{disposition.count}
              </li>
            ))}
          </ul>
          <a
            href={intake.url}
            target="_blank"
            rel="noopener noreferrer"
            class="text-xs font-[family-name:var(--font-mono)] text-[var(--color-accent-secondary)] hover:underline"
          >&rarr; Read the ledger: {intake.path}</a>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
