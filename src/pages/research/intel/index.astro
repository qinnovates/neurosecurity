---
import PageLayout from '@/layouts/PageLayout.astro';
import { TARA_TECHNIQUES } from '../../../lib/qif-constants';
import { buildReportModel } from '@/lib/intel/bci-security-2026/report-model';
import { formatPercent, formatUsdCompact } from '@/lib/intel/bci-security-2026/format';

const annual = buildReportModel();
---

<PageLayout title="Qinnovate Global BCI Landscape Report | Qinnovate" description="Qinnovate's research reports on the BCI industry: capital, clinical momentum and the measured state of BCI security, built from the public datalake.">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-4xl font-bold mb-4 bg-gradient-to-r from-[var(--color-accent-primary)] via-[var(--color-accent-secondary)] to-[var(--color-accent-tertiary)] bg-clip-text text-transparent">
      BCI Intelligence Reports
    </h1>
    <p class="text-lg text-[var(--color-text-muted)] mb-8 max-w-2xl">
      An annual report on BCI capital, clinical momentum and the measured state of BCI security, built from the public datalake. Between editions,
      the <a href="/research/landscape/" class="text-[var(--color-accent-primary)] hover:underline">BCI Landscape</a> page carries the live data.
    </p>

    <div class="space-y-6">
      <div class="glass rounded-xl border border-[var(--color-border)] p-6">
        <h2 class="text-xl font-semibold text-[var(--color-text-primary)] mb-4 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[var(--color-accent-secondary)]"></span>
          2026
        </h2>
        <div class="space-y-3">
          <a href="/research/intel/2026/landscape-report/" class="block glass rounded-lg border border-[var(--color-accent-primary)]/40 p-4 hover:border-[var(--color-accent-primary)] transition-colors group">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-base font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-primary)] transition-colors">
                  {annual.meta.title}
                </h3>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">
                  Annual edition. {formatUsdCompact(annual.rounds.totalUsd)} in disclosed 2026 rounds; {formatPercent(annual.capital.noneFoundShare)} of tracked capital sits in companies with no
                  vulnerability-disclosure channel we could find; {annual.cve.total} neural-device CVEs; {formatPercent(annual.evidence.strictShare)} of the threat catalog demonstrated.
                </p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-green-500/10 text-green-400 border border-green-500/20">PUBLISHED</span>
                <span class="text-xs text-[var(--color-text-faint)]">Oct 20, 2026</span>
              </div>
            </div>
          </a>

          <a href="/research/intel/2026/q1/" class="block glass rounded-lg border border-[var(--color-border)] p-4 hover:border-[var(--color-accent-primary)]/40 transition-colors group">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h3 class="text-base font-semibold text-[var(--color-text-primary)] group-hover:text-[var(--color-accent-primary)] transition-colors">
                  Q1 2026 BCI Intelligence Report
                </h3>
                <p class="text-sm text-[var(--color-text-muted)] mt-1">
                  The first edition, 57 companies and 109 catalogued techniques. Corrections issued 20 Oct 2026 in the annual edition.
                </p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-[var(--color-text-faint)]/10 text-[var(--color-text-muted)] border border-[var(--color-text-faint)]/20">CORRECTED</span>
                <span class="text-xs text-[var(--color-text-faint)]">Mar 13, 2026</span>
              </div>
            </div>
          </a>

          <div class="block glass rounded-lg border border-[var(--color-border)]/50 p-4 opacity-60">
            <h3 class="text-base font-semibold text-[var(--color-text-muted)]">Q2 and Q3 2026 quarterly reports</h3>
            <p class="text-sm text-[var(--color-text-faint)] mt-1">Superseded: the quarterly series was replaced by the 2026 annual edition.</p>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-10 glass rounded-xl border border-[var(--color-border)] p-5">
      <h3 class="text-sm font-semibold text-[var(--color-text-primary)] mb-2">Methodology</h3>
      <p class="text-sm text-[var(--color-text-muted)]">
        Reports are built from the public datalake: the BCI company tracker ({annual.companies} companies), the TARA threat catalog ({TARA_TECHNIQUES} techniques, each with an
        evidence tier) and the CVE-technique mapping. Funding, regulatory and clinical claims are checked against dated primary sources, and every source is recorded
        in the datalake intake ledger. Each report has its own methodology section.
      </p>
    </div>
  </div>
</PageLayout>
