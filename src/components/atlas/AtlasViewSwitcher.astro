---
import LensToggle from '../LensToggle.tsx';

interface Props {
  current: string;
}

const { current } = Astro.props;

interface AtlasTab {
  label: string;
  href: string;
  /** The target page has its own layout without the client router, so it needs a full page load. */
  needsFullPageLoad?: boolean;
}

// Collapsed from 10 tabs to 3 (2026-10 redesign): Hub and Catalog merged into one
// page (/atlas/tara/), Explorer retired as a separate destination (folded into the
// Catalog's own filters), and Scoring/Clinical/Domains/Devices/Brain Atlas/Model
// demoted to links inside the single "Advanced" page instead of competing, equal-
// weight top-level tabs with no shared vocabulary.
const tabs: AtlasTab[] = [
  { label: 'Catalog', href: '/atlas/tara/' },
  { label: 'Chains', href: '/atlas/chains/' },
  { label: 'Advanced: Visualize & Model', href: '/atlas/model/', needsFullPageLoad: true },
];

function isActive(href: string, currentPath: string): boolean {
  const norm = currentPath.replace(/\/$/, '') || '/';
  const tabNorm = href.replace(/\/$/, '') || '/';
  return norm === tabNorm;
}
---

<nav
  class="atlas-view-switcher sticky z-30 -mx-4 px-4 py-2 scrollbar-hide"
  style="top: var(--nav-height, 64px); background: color-mix(in srgb, var(--color-glass-bg) 85%, transparent); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--color-glass-border);"
  aria-label="Atlas sub-navigation"
>
  <div class="flex flex-col lg:flex-row lg:items-center gap-1.5">
    {/* Scrollable tabs. Below the lg breakpoint this gets the full row width instead of
        sharing it with the lens toggle, which previously squeezed 10 tabs into ~153px of
        a 375px viewport (7 of them reachable only by a hidden, undiscoverable scrollbar) and
        still cut off the last 3 tabs at 768px (the tab strip's natural width is ~746px, wider
        than 768px minus nav padding and the lens toggle). The edge-fade mask gives a visual
        cue that there's more to scroll either way. */}
    <div class="atlas-tab-scroll flex-1 min-w-0 overflow-x-auto scrollbar-hide">
      <div class="flex items-center gap-1.5 min-w-max">
        {tabs.map((tab) => {
          const active = isActive(tab.href, current);
          return (
            <a
              href={tab.href}
              class:list={[
                'atlas-tab inline-flex items-center justify-center min-h-11 px-3 py-1 rounded-full text-xs font-medium transition-all duration-200 whitespace-nowrap',
                active ? 'atlas-tab--active' : 'atlas-tab--inactive',
              ]}
              aria-current={active ? 'page' : undefined}
              data-astro-reload={tab.needsFullPageLoad}
            >
              {tab.label}
            </a>
          );
        })}
      </div>
    </div>
    {/* Divider + pinned lens toggle */}
    <div
      class="flex-shrink-0 self-start lg:self-auto pt-1.5 lg:pt-0 lg:pl-2 lg:ml-1 border-t lg:border-t-0 lg:border-l"
      style="border-color: var(--color-border);"
    >
      <LensToggle client:idle />
    </div>
  </div>
</nav>

<style>
  .atlas-tab--active {
    /* White text sits on this tab, so it takes the fill token, not the link accent: the dark
       accent (cyan) reads at 1.5:1 under white text, far below the WCAG AA 4.5:1 minimum for
       12px text (axe-core: color-contrast, serious). --color-accent-fill is kept white-text
       safe in both themes (dark 5.2:1, light 8.5:1). */
    background: var(--color-accent-fill);
    color: #fff;
    box-shadow: 0 1px 6px color-mix(in srgb, var(--color-accent-primary) 30%, transparent);
  }
  .atlas-tab--inactive {
    background: var(--color-glass-bg);
    color: var(--color-text-muted);
    border: 1px solid var(--color-glass-border);
  }
  .atlas-tab--inactive:hover {
    color: var(--color-text-primary);
    border-color: var(--color-accent-primary);
    background: color-mix(in srgb, var(--color-accent-primary) 8%, var(--color-glass-bg));
  }
  /* Edge-fade affordance so a horizontally-scrollable tab strip with a hidden scrollbar
     still signals there's more to scroll, instead of looking like a hard, final cut-off. */
  .atlas-tab-scroll {
    -webkit-mask-image: linear-gradient(to right, black calc(100% - 20px), transparent 100%);
    mask-image: linear-gradient(to right, black calc(100% - 20px), transparent 100%);
  }
  /* .scrollbar-hide itself lives in src/styles/global.css: a scoped Astro <style> block
     can't be shared with any React island that also needs it. */
</style>
