---
/**
 * The one way in from this site to Glia, the full console this site previews a slice of.
 * Glia itself stays non-public, and a request has to be private: a public issue on this repo
 * is not, and a mailto has no address to publish yet. So the way in is a direct message to the
 * maintainer on Threads. Threads has no address that opens a message, so this opens the profile
 * and the visitor presses Message there. No form, no backend, no data held by this site.
 */
export interface Props {
  /** Shorter copy for a tight space (a nav bar, a card footer). Default fits a standalone placement. */
  compact?: boolean;
}
const { compact = false } = Astro.props;
const THREADS_HANDLE = '@crazyrealasian';
const REQUEST_URL = 'https://www.threads.com/@crazyrealasian';
---
<a class="request-access-cta glass" class:list={{ 'request-access-cta--compact': compact }} href={REQUEST_URL} target="_blank" rel="noopener noreferrer" data-request-access="threads">
  <span class="request-access-cta__label">Request Glia access</span>
  {!compact && <span class="request-access-cta__sub">Glia isn&rsquo;t public yet. This opens a private message to the maintainer on Threads ({THREADS_HANDLE}).</span>}
</a>

<style>
  .request-access-cta {
    display: inline-flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0.75rem;
    color: var(--color-accent-primary);
    text-decoration: none;
    font-weight: 600;
    transition: border-color var(--motion-fast) ease, transform var(--motion-fast) ease;
  }
  .request-access-cta:hover {
    transform: translateY(-1px);
  }
  .request-access-cta__label {
    font-size: 0.9375rem;
  }
  .request-access-cta__sub {
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
  }
  .request-access-cta--compact {
    padding: 0.5rem 0.875rem;
    border-radius: 0.5rem;
  }
  .request-access-cta--compact .request-access-cta__label {
    font-size: 0.8125rem;
  }
</style>
