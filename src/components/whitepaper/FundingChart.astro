---
import companies from '../../data/bci-funding.json';

const TYPE_LABELS: Record<string, string> = { invasive: 'Implanted', noninvasive: 'Wearable', therapeutic: 'Therapeutic', other: 'Other or acquired' };
const STAGGER_MS = 30;
const largest = Math.max(...companies.map((company) => company.funding_usd));
const total = companies.reduce((sum, company) => sum + company.funding_usd, 0);

function formatFunding(amount: number): string {
  if (amount >= 1e9) return `$${(amount / 1e9).toFixed(2)}B`;
  return `$${(amount / 1e6).toFixed(amount < 1e7 ? 1 : 0)}M`;
}
---
<div class="funding-chart glass rounded-xl mb-2">
  <table>
    <caption>Disclosed funding by BCI company. Total {formatFunding(total)} across {companies.length} companies.</caption>
    <thead><tr><th scope="col">Company</th><th scope="col">Type</th><th scope="col">Disclosed funding</th></tr></thead>
    <tbody>
      {companies.map((company, position) => (
        <tr data-type={company.type} style={`--share: ${(company.funding_usd / largest) * 100}%; --delay: ${position * STAGGER_MS}ms;`}>
          <th scope="row">{company.name}{company.note && <span>{company.note}</span>}</th>
          <td>{TYPE_LABELS[company.type]}</td>
          <td><div class="funding-bar" aria-hidden="true"><i /></div><b>{formatFunding(company.funding_usd)}</b></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .funding-chart { max-height: 36rem; overflow: auto; padding: 0.75rem 1rem; }
  table { width: 100%; border-collapse: collapse; font-size: 0.8125rem; }
  caption { padding-bottom: 0.75rem; text-align: left; color: var(--color-text-muted); }
  thead th { position: sticky; top: -0.75rem; padding: 0.375rem 0.5rem; text-align: left; font-weight: 600; color: var(--color-text-muted); background: var(--color-bg-surface); }
  tbody tr { border-top: 1px solid var(--color-border); }
  tbody tr:hover { background: var(--color-glass-tint); }
  tbody th, td { padding: 0.375rem 0.5rem; text-align: left; font-weight: 400; color: var(--color-text-primary); vertical-align: middle; }
  td:nth-child(2) { color: var(--color-text-muted); white-space: nowrap; }
  td:nth-child(3) { width: 45%; min-width: 9rem; }
  tbody th span { display: block; font-size: 0.6875rem; color: var(--color-text-faint); }
  b { font-weight: 600; font-variant-numeric: tabular-nums; }
  .funding-bar { height: 0.375rem; margin-bottom: 0.25rem; border-radius: 3px; background: var(--color-border); overflow: hidden; }
  .funding-bar i { display: block; height: 100%; width: var(--share); min-width: 2px; border-radius: 3px; background: var(--color-accent-primary); transform-origin: left; animation: funding-grow 0.7s ease-out var(--delay) both; }
  tr[data-type='therapeutic'] .funding-bar i { background: var(--color-accent-secondary); }
  tr[data-type='invasive'] .funding-bar i { background: var(--color-accent-tertiary); }
  tr[data-type='other'] .funding-bar i { background: var(--color-text-muted); }
  @keyframes funding-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media (prefers-reduced-motion: reduce) { .funding-bar i { animation: none; } }
</style>
