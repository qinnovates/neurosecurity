---
// Section 2 (Part 1): where 2026 capital and clinical momentum went.
import ChartFigure from '../ChartFigure.astro';
import RoundsBarChart from '../RoundsBarChart.astro';
import YearColumnChart from '../YearColumnChart.astro';
import SourceLinks from '../SourceLinks.astro';
import type { ReportModel } from '@/lib/intel/bci-security-2026/report-model';
import { formatPercent, formatReportDate, formatUsdCompact } from '@/lib/intel/bci-security-2026/format';
import { resolveSources } from '@/lib/intel/bci-security-2026/report-data';

interface Props {
  model: ReportModel;
}

const { model } = Astro.props;
const { rounds, vc, report } = model;
const roundSources = resolveSources([...new Set(rounds.rounds.flatMap((round) => round.source_ids))]);
// The tracker name only; the datalake's free-text qualifiers are not shown as findings.
const trackerName = (source: string | undefined): string => (source ?? 'cited tracker').split(' (')[0];
const isPartialYear = (year: { note?: string; source?: string }): boolean => /partial year/i.test(`${year.note ?? ''} ${year.source ?? ''}`);
const yearLabel = (year: { year: number; note?: string; source?: string }): string => `${year.year}${isPartialYear(year) ? ' (partial)' : ''}`;
const vcColumns = vc.map((year) => ({ year: year.year, valueUsd: year.total_usd, detail: `${year.deals} deals, per ${trackerName(year.source)}${isPartialYear(year) ? '; partial-year figure' : ''}` }));
const partialYears = vc.filter(isPartialYear).map((year) => year.year);
const topFour = rounds.rounds.slice(0, 4).map((round) => round.company);
const topFourList = `${topFour.slice(0, -1).join(', ')} and ${topFour[topFour.length - 1]}`;
const announcements = report.announcement_audit;
const securityMentions = announcements.mention_device_security === 0 ? 'None' : String(announcements.mention_device_security);
---
<section id="capital" aria-labelledby="capital-heading" class="scroll-mt-24">
  <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Section 2</p>
  <h2 id="capital-heading" class="text-2xl font-bold font-[family-name:var(--font-heading)]">Capital and clinic</h2>
  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-[var(--color-text-muted)]">
    We count only rounds we could confirm at a dated source: {rounds.rounds.length} rounds totalling {formatUsdCompact(rounds.totalUsd)}{' '}
    between 1 January and 20 October 2026. {topFourList} account for {formatPercent(rounds.topFourShare)} of it, and implant
    programs took {formatPercent(rounds.implantShare)} of the dollars. Undisclosed rounds and many Chinese financings are missing, so the
    true total is higher.
  </p>

  <ChartFigure id="figure-2" number={2} title="Disclosed BCI funding rounds, January to October 2026"
    takeaway={`Four rounds make up ${formatPercent(rounds.topFourShare)} of ${formatUsdCompact(rounds.totalUsd)}.`}
    sources={roundSources}
    datalakeNote="BrainCo and Merge Labs amounts match datalake funding rows; the rest are recorded in intake batch 2026-10-20."
  >
    <RoundsBarChart rounds={rounds.rounds} />
    <table slot="table" class="viz-table">
      <thead><tr><th>Company</th><th>Round</th><th>Date</th><th>Class</th><th class="viz-right">Amount</th></tr></thead>
      <tbody>
        {rounds.rounds.map((round) => (
          <tr><td>{round.company}</td><td>{round.round}</td><td>{formatReportDate(round.date)}</td><td>{round.device_class === 'implant' ? 'Implant' : 'Non-invasive'}</td><td class="viz-right">{formatUsdCompact(round.amount_usd)}</td></tr>
        ))}
      </tbody>
    </table>
  </ChartFigure>

  <ChartFigure id="figure-3" number={3} title="Neurotechnology venture funding by year, as reported by third-party trackers"
    takeaway={`Context, not our measurement: tracker totals for the whole neurotech sector rose every year, and the ${partialYears.join(', ')} figure is a partial-year count that already exceeds the full 2024 total.`}
    sources={[]}
    datalakeNote={`Source: datalake/bci-landscape.json market_data.vc_aggregate_by_year (PitchBook for 2022–2023; Neurotechnology Substack for 2024–2025). Trackers differ in scope and the ${partialYears.join(', ')} count is marked partial-year in the datalake, so treat the series as indicative.`}
  >
    <YearColumnChart columns={vcColumns} ariaLabel="Neurotechnology venture funding by year" />
    <table slot="table" class="viz-table">
      <thead><tr><th>Year</th><th class="viz-right">Deals</th><th class="viz-right">Total</th><th>Source</th></tr></thead>
      <tbody>
        {vc.map((year) => (<tr><td>{yearLabel(year)}</td><td class="viz-right">{year.deals}</td><td class="viz-right">{formatUsdCompact(year.total_usd)}</td><td>{trackerName(year.source)}{isPartialYear(year) ? ', partial year' : ''}</td></tr>))}
      </tbody>
    </table>
  </ChartFigure>

  <h3 class="mt-8 text-lg font-semibold">Clinical and regulatory momentum</h3>
  <ol class="mt-3 divide-y divide-[var(--color-border)] text-sm">
    {report.clinical_milestones.map((milestone) => (
      <li class="grid grid-cols-[6.5rem_1fr] gap-3 py-2">
        <span class="viz-num text-xs font-semibold text-[var(--color-text-primary)]">{formatReportDate(milestone.date)}</span>
        <span class="text-[var(--color-text-muted)]">
          {milestone.label}<SourceLinks ids={milestone.source_ids} />
        </span>
      </li>
    ))}
  </ol>
  <p class="mt-3 text-xs text-[var(--color-text-faint)]">
    The 2026 FDA decision that lets an implanted BCI connect to personal computing devices widens the attack surface: the implant's
    data path now reaches general-purpose, internet-connected hardware. {securityMentions} of the {announcements.readable} 2026 announcements we could read in full
    mention{announcements.mention_device_security === 1 ? 's' : ''} device security (Section 3).
  </p>
</section>
