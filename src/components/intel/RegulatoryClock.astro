---
// Compliance dates on one time rail with a marker for the report date, then the same
// dates as a list so every label stays readable at phone width.
import type { DatedEvent } from '@/lib/intel/bci-security-2026/types';
import { formatReportDate, toFractionalYear } from '@/lib/intel/bci-security-2026/format';

interface Props {
  events: DatedEvent[];
  asOf: string;
  startYear: number;
  endYear: number;
}

const MONTHS_PER_YEAR = 12;
const { events, asOf, startYear, endYear } = Astro.props;
const span = endYear - startYear;
const position = (isoDate: string): number => ((toFractionalYear(isoDate) - startYear) / span) * 100;
const monthsUntil = (isoDate: string): number => Math.round((toFractionalYear(isoDate) - toFractionalYear(asOf)) * MONTHS_PER_YEAR);
const rows = [...events].sort((a, b) => a.date.localeCompare(b.date)).map((event) => ({ ...event, months: monthsUntil(event.date) }));
const yearTicks = Array.from({ length: span + 1 }, (_, index) => startYear + index);
---
<div class="relative mx-2 mt-6 mb-8 h-1 rounded-full bg-[var(--viz-grid)]" role="group" aria-label={`Compliance dates from ${startYear} to ${endYear}; report date ${formatReportDate(asOf)}`}>
  <div class="absolute inset-y-0 left-0 rounded-full bg-[var(--viz-axis)]" style={`width:${position(asOf)}%;`} aria-hidden="true"></div>
  {rows.map((row) => (
    <span
      class="viz-mark absolute top-1/2 block h-3 w-3 -translate-x-1/2 -translate-y-1/2 rounded-full"
      style={`left:${position(row.date)}%;box-shadow:0 0 0 2px var(--viz-surface);`
        + (row.months <= 0 ? 'background:var(--viz-accent);' : 'background:var(--viz-surface);border:2px solid var(--viz-accent);')}
      data-tip-value={formatReportDate(row.date)}
      data-tip-label={`${row.label} (${row.jurisdiction})`}
      tabindex="0"
      aria-label={`${formatReportDate(row.date)}: ${row.label}`}
    ></span>
  ))}
  <span class="absolute -top-6 -translate-x-1/2 text-[11px] font-semibold text-[var(--color-text-primary)]" style={`left:${position(asOf)}%;`}>Today</span>
  <span class="absolute -top-2 h-5 w-px bg-[var(--color-text-primary)]" style={`left:${position(asOf)}%;`} aria-hidden="true"></span>
  {yearTicks.map((year) => (
    <span class="viz-num absolute top-3 -translate-x-1/2 text-[11px] text-[var(--color-text-faint)]" style={`left:${((year - startYear) / span) * 100}%;`} aria-hidden="true">{year}</span>
  ))}
</div>
<ol class="divide-y divide-[var(--color-border)] text-sm">
  {rows.map((row) => (
    <li class="grid grid-cols-[6.5rem_1fr] gap-3 py-2 sm:grid-cols-[7.5rem_1fr_auto]">
      <span class="viz-num text-xs font-semibold text-[var(--color-text-primary)]">{formatReportDate(row.date)}</span>
      <span class="text-[var(--color-text-muted)]">{row.label} <span class="text-[11px] text-[var(--color-text-faint)]">({row.jurisdiction})</span></span>
      <span class="col-start-2 text-[11px] text-[var(--color-text-faint)] sm:col-start-3 sm:text-right">
        {row.months <= 0 ? 'In effect' : `In ${row.months} month${row.months === 1 ? '' : 's'}`}
      </span>
    </li>
  ))}
</ol>
