---
// Stat tile: label, value, one line of context and where the number comes from.
interface Props {
  label: string;
  value: string;
  context: string;
  trace: string;
}

const { label, value, context, trace } = Astro.props;
---
<div class="flex flex-col rounded-xl border border-[var(--color-border)] bg-[var(--color-glass-bg)] p-4">
  <p class="text-xs font-medium text-[var(--color-text-muted)]">{label}</p>
  <p class="mt-1 text-3xl font-semibold leading-none tracking-tight text-[var(--color-text-primary)]">{value}</p>
  <p class="mt-2 text-sm leading-snug text-[var(--color-text-muted)]">{context}</p>
  <p class="mt-auto pt-3 text-[11px] leading-snug text-[var(--color-text-faint)]">{trace}</p>
</div>
