---
// Columns for a short annual series (one hue), value on each cap. Few columns, so every
// one is labelled and the gridlines can stay out.
import { formatUsdCompact } from '@/lib/intel/bci-security-2026/format';
import type { YearColumn } from './chart-types';

interface Props {
  columns: YearColumn[];
  ariaLabel: string;
}

const PLOT_HEIGHT_PX = 160;
const { columns, ariaLabel } = Astro.props;
const largest = Math.max(...columns.map((column) => column.valueUsd));
---
<div class="flex items-end justify-around gap-3 border-b border-[var(--viz-axis)] px-2" style={`height:${PLOT_HEIGHT_PX + 28}px;`} role="group" aria-label={ariaLabel}>
  {columns.map((column) => (
    <div class="flex flex-1 max-w-[4.5rem] flex-col items-center justify-end h-full">
      <span class="viz-num mb-1 text-xs font-semibold text-[var(--color-text-primary)]">{formatUsdCompact(column.valueUsd)}</span>
      <span
        class="viz-mark block w-6 rounded-t"
        style={`height:${Math.max(3, (column.valueUsd / largest) * PLOT_HEIGHT_PX)}px;background:var(--viz-accent);`}
        data-tip-value={formatUsdCompact(column.valueUsd)}
        data-tip-label={`${column.year}: ${column.detail}`}
        tabindex="0"
        aria-label={`${column.year}: ${formatUsdCompact(column.valueUsd)}, ${column.detail}`}
      ></span>
    </div>
  ))}
</div>
<div class="flex justify-around gap-3 px-2 pt-1.5">
  {columns.map((column) => (
    <span class="viz-num flex-1 max-w-[4.5rem] text-center text-xs text-[var(--color-text-muted)]">{column.year}</span>
  ))}
</div>
