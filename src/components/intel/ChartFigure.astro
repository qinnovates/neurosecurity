---
// Figure container for one report chart: number, title, takeaway, legend, the plot,
// a table-view twin and the source line. The table is the accessible equivalent.
import type { ReportSource } from '@/lib/intel/bci-security-2026/types';
import type { LegendEntry } from './chart-types';

interface Props {
  id: string;
  number: number;
  title: string;
  takeaway: string;
  legend?: LegendEntry[];
  sources: ReportSource[];
  datalakeNote?: string;
}

const { id, number, title, takeaway, legend = [], sources, datalakeNote } = Astro.props;
const swatchRadius = (shape: LegendEntry['shape']): string => (shape === 'circle' || shape === 'ring' ? '9999px' : '2px');
---
<figure id={id} class="viz not-prose my-8 rounded-xl border border-[var(--color-border)] bg-[var(--color-glass-bg)] p-4 sm:p-6 scroll-mt-24" aria-labelledby={`${id}-title`}>
  <p class="text-[11px] font-semibold uppercase tracking-[0.12em] text-[var(--color-text-faint)]">Figure {number}</p>
  <h3 id={`${id}-title`} class="mt-1 text-base sm:text-lg font-semibold leading-snug text-[var(--color-text-primary)]">{title}</h3>
  <p class="mt-1 text-sm text-[var(--color-text-muted)]">{takeaway}</p>
  {legend.length > 1 && (
    <ul class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-[var(--color-text-muted)]" aria-label="Legend">
      {legend.map((entry) => (
        <li class="flex items-center gap-1.5">
          <span
            class="viz-swatch"
            style={entry.shape === 'ring'
              ? `border:2px solid var(${entry.colorVar});background:transparent;border-radius:9999px;`
              : `background:var(${entry.colorVar});border-radius:${swatchRadius(entry.shape)};${entry.shape === 'diamond' ? 'transform:rotate(45deg) scale(0.85);' : ''}`}
            aria-hidden="true"
          ></span>
          {entry.label}
        </li>
      ))}
    </ul>
  )}
  <div class="mt-4">
    <slot />
  </div>
  <details class="mt-4 group">
    <summary class="cursor-pointer select-none text-xs font-medium text-[var(--color-accent-primary)] hover:underline">Show the data as a table</summary>
    <div class="mt-3 overflow-x-auto">
      <slot name="table" />
    </div>
  </details>
  <figcaption class="mt-4 border-t border-[var(--color-border)] pt-3 text-[11px] leading-relaxed text-[var(--color-text-faint)]">
    {datalakeNote && <span>{datalakeNote} </span>}
    {sources.length > 0 && (
      <span>
        Source{sources.length > 1 ? 's' : ''}:{' '}
        {sources.map((source, index) => (
          <>
            <a href={source.url} target="_blank" rel="noopener noreferrer" class="underline decoration-dotted hover:text-[var(--color-accent-primary)]">{source.publisher}</a>
            {` (${source.date})`}{index < sources.length - 1 ? '; ' : '.'}
          </>
        ))}
      </span>
    )}
  </figcaption>
</figure>
