---
import Search from 'astro-pagefind/components/Search.astro';
import ThemeToggle from './ThemeToggle.astro';
import LogoMark from './LogoMark.astro';
import ExploreIcon from './ExploreIcon.astro';
import { TARA_TECHNIQUES } from '../lib/qif-constants';
import { NEURORIGHT_COUNT } from '../lib/neurorights-taxonomy';

const currentPath = Astro.url.pathname;

// --- Nav structure: sections > groups > links ---
interface NavLink { href: string; label: string; desc?: string }
interface NavGroup { title: string; links: NavLink[] }
interface NavSection { id: string; label: string; href: string; groups: NavGroup[]; isActive?: boolean }

const taraGroups: NavGroup[] = [
  {
    title: 'The Catalog',
    links: [
      { href: '/atlas/tara/', label: 'TARA Threat Catalog', desc: `${TARA_TECHNIQUES} BCI attack techniques, scored and mapped` },
      { href: '/atlas/tara/ttps/', label: 'Threat Matrix (TTPs)', desc: 'Tactics, techniques & procedures by domain' },
      { href: '/atlas/tara/numbering/', label: 'QIF Numbering', desc: 'Technique IDs and tactic codes' },
      { href: '/atlas/analysis/', label: 'Case Studies', desc: 'Hardware-validated attack chain deep dives' },
    ],
  },
  {
    title: 'Apply It',
    links: [
      { href: '/atlas/scoring/', label: 'NISS Scoring', desc: 'Neural Impact Severity Score for each technique' },
      { href: '/atlas/clinical/', label: 'Clinical Mappings', desc: 'DSM-5-TR category references, therapeutic analogs' },
    ],
  },
];

const frameworkGroups: NavGroup[] = [
  {
    title: "What TARA Is Built On",
    links: [
      { href: '/framework/', label: 'QIF Hourglass Architecture', desc: 'Proposed 11-band model TARA techniques are mapped against' },
      { href: '/governance/rights/', label: 'Neurorights', desc: `${NEURORIGHT_COUNT} proposed neurorights TARA techniques are scored against` },
    ],
  },
  {
    title: "Future Work: Planned Specifications",
    links: [
      { href: '/guardrails/', label: 'Signal Boundary', desc: 'Planned signal-layer firewall spec at I0' },
      { href: '/guardrails/nsp/', label: 'NSP Protocol', desc: 'Planned post-quantum wire security' },
      { href: '/guardrails/runemate/', label: 'Staves', desc: 'Planned on-device policy compiler spec' },
    ],
  },
];

const researchGroups: NavGroup[] = [
  {
    title: 'Publications',
    links: [
      { href: '/research/whitepaper/', label: 'Whitepaper', desc: 'Full QIF specification' },
      { href: '/research/papers/', label: 'Papers', desc: 'Peer-review track submissions' },
      { href: '/news/', label: 'Field Journal', desc: 'Research notes and announcements' },
    ],
  },
  {
    title: 'Data & Landscape',
    links: [
      { href: '/data-studio/', label: 'Data Studio', desc: 'Browse and SQL-query the full research datalake' },
      { href: '/research/landscape/', label: 'BCI Landscape', desc: 'Market and device landscape' },
      { href: '/research/bci-explorer/', label: 'BCI Hardware Explorer', desc: 'Devices, FDA filings, physics constraints' },
      { href: '/research/provenance/', label: 'Data Provenance', desc: 'Every tracked figure, its source file, and when it was last verified' },
      { href: '/tools/', label: 'Tools & Plugins', desc: 'Open-source security tools and AI plugins' },
    ],
  },
  {
    title: 'Intelligence',
    links: [
      { href: '/research/intel/', label: 'Global BCI Landscape Report', desc: 'Funding, regulation, threat landscape' },
      { href: '/tools/intel/', label: 'Live Intel Feed', desc: 'STIX 2.1 / TAXII, 74+ sources' },
    ],
  },
];

const aboutGroups: NavGroup[] = [
  {
    title: 'Institute',
    links: [
      { href: '/mission/', label: 'Mission', desc: 'Why this framework exists' },
      { href: '/governance/', label: 'Governance & Ethics', desc: 'Code of ethics, transparency, AI-assist disclosure' },
      { href: '/about/', label: 'About & Transparency', desc: 'Who is behind this, current stage, how to collaborate' },
    ],
  },
  {
    title: 'Progress',
    links: [
      { href: '/news/roadmap/', label: 'Roadmap', desc: 'Milestones and version history' },
      { href: '/news/derivation/', label: 'Derivation Log', desc: 'Live research journal' },
    ],
  },
];

const isTaraActive = currentPath.startsWith('/atlas/');
const isFrameworkActive = currentPath.startsWith('/framework/') || currentPath.startsWith('/guardrails/');
const isResearchActive = currentPath.startsWith('/research/') || currentPath.startsWith('/data-studio/')
  || currentPath.startsWith('/tools/') || (currentPath.startsWith('/news/') && !currentPath.startsWith('/news/roadmap/') && !currentPath.startsWith('/news/derivation/'));
const isAboutActive = currentPath.startsWith('/mission/') || currentPath.startsWith('/governance/')
  || currentPath.startsWith('/about/') || currentPath === '/news/roadmap/' || currentPath === '/news/derivation/';

const navSections: NavSection[] = [
  { id: 'tara', label: 'TARA', href: '/atlas/tara/', groups: taraGroups, isActive: isTaraActive },
  { id: 'framework', label: 'Framework', href: '/framework/', groups: frameworkGroups, isActive: isFrameworkActive },
  { id: 'research', label: 'Research', href: '/research/', groups: researchGroups, isActive: isResearchActive },
  { id: 'about', label: 'About', href: '/mission/', groups: aboutGroups, isActive: isAboutActive },
];
---

<nav class="nav-root fixed top-4 left-0 right-0 z-50 pointer-events-none px-4 sm:px-6 lg:px-8" id="main-nav" transition:persist>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-3">
    <div class="nav-bar-row flex items-center justify-between h-9 w-full">
      <!-- Logo -->
      <a href="/" class="pointer-events-auto flex items-center gap-2 hover:opacity-80 transition-opacity enter-fade" style="--enter-i: 0" aria-label="Qinnovate home">
        <span class="nav-logo"><LogoMark maskId="nav-logo-knockout" /></span>
        <span class="text-xs text-[var(--color-text-faint)] hidden sm:inline ml-1">|</span>
        <span class="text-xs font-medium tracking-wide hidden sm:inline text-[var(--color-text-muted)]">Open Neural Atlas</span>
      </a>

      <!-- Desktop links -->
      <div class="nav-pill pointer-events-auto hidden lg:flex items-center gap-10 h-9 px-5 rounded-full enter-fade" style="--enter-i: 1">
        {navSections.map((section) => (
          <div class="relative" data-dropdown={section.id}>
            <a
              href={section.href}
              aria-expanded="false"
              class:list={[
                "nav-link flex items-center gap-1 transition-colors",
                section.isActive ? "nav-link-active" : ""
              ]}
            >
              {section.label}
              <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </a>
            <div class="dropdown-menu absolute left-0 top-full pt-2 hidden">
              <div class="nav-dropdown rounded-2xl overflow-hidden max-h-[75vh] overflow-y-auto"
                style={`width: ${section.groups.length > 2 ? '640px' : '420px'};`}
              >
                <div class={`p-3 ${section.groups.length > 2 ? 'grid grid-cols-3 gap-3' : section.groups.length === 2 ? 'grid grid-cols-2 gap-3' : ''}`}>
                  {section.groups.map((group) => (
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-[0.12em] px-2 py-1.5 mb-1" style="color: var(--color-text-faint);">
                        {group.title}
                      </p>
                      {group.links.map((link) => (
                        <a
                          href={link.href}
                          class:list={[
                            "block px-2 py-2 rounded-lg transition-colors",
                            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                              ? "nav-item-active"
                              : "text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-black/5"
                          ]}
                        >
                          <span class="text-sm font-medium block leading-snug">{link.label}</span>
                          {link.desc && (
                            <span class="text-[11px] block mt-0.5 leading-snug" style="color: var(--color-text-faint);">{link.desc}</span>
                          )}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right side -->
      <div class="pointer-events-auto flex items-center gap-2">
        <span class="enter-fade" style="--enter-i: 2"><ThemeToggle /></span>

        <!-- Search button -->
        <button
          id="search-btn"
          class="nav-round enter-fade"
          style="--enter-i: 3"
          aria-label="Search"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </button>

        <!-- Explore TARA CTA: glass pill with crosshair, same tint as the link bar -->
        <a
          href="/atlas/tara/"
          class:list={[
            "nav-cta hidden md:inline-flex items-center gap-2 px-4 h-9 rounded-full text-base enter-fade",
            currentPath.startsWith('/atlas/tara') ? "nav-cta-active" : ""
          ]}
          style="--enter-i: 4"
        >
          <ExploreIcon />
          Explore TARA
        </a>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="nav-round lg:hidden enter-fade"
          style="--enter-i: 5"
          aria-label="Open menu"
          aria-expanded="false"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu: a black sheet that opens outward from the menu button, top-level sections only -->
  <div id="mobile-menu" class="mobile-sheet lg:hidden hidden">
    <ul class="mobile-sheet-list">
      {navSections.map((section) => (
        <li>
          <a
            href={section.href}
            class:list={["mobile-sheet-link", section.isActive ? "nav-item-active" : ""]}
          >
            {section.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/atlas/tara/" class="nav-cta nav-cta-menu mobile-sheet-cta">
      <ExploreIcon />
      Explore TARA
    </a>
  </div>
</nav>

<!-- Search modal -->
<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Site search">
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative max-w-2xl mx-auto mt-20 px-4">
    <div class="glass rounded-xl p-4 shadow-2xl" id="search-container">
      <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, showSubResults: true }} />
    </div>
  </div>
</div>

<script>
  function initNav() {
    // Mobile menu
    const menuBtn = document.getElementById('mobile-menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    menuBtn?.addEventListener('click', () => {
      const expanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!expanded));
      mobileMenu?.classList.toggle('hidden');
    });

    document.addEventListener('astro:before-swap', () => {
      mobileMenu?.classList.add('hidden');
      menuBtn?.setAttribute('aria-expanded', 'false');
    });

    // Desktop dropdowns (hover + focus)
    document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
      const menu = dropdown.querySelector<HTMLElement>('.dropdown-menu');
      let timeout: ReturnType<typeof setTimeout>;

      const trigger = dropdown.querySelector<HTMLElement>('a[aria-expanded]');

      function show() {
        document.querySelectorAll<HTMLElement>('.dropdown-menu').forEach(m => {
          if (m !== menu) m.classList.add('hidden');
        });
        document.querySelectorAll<HTMLElement>('[data-dropdown] a[aria-expanded]').forEach(t => {
          if (t !== trigger) t.setAttribute('aria-expanded', 'false');
        });
        clearTimeout(timeout);
        menu?.classList.remove('hidden');
        trigger?.setAttribute('aria-expanded', 'true');
      }

      function hide() {
        timeout = setTimeout(() => {
          menu?.classList.add('hidden');
          trigger?.setAttribute('aria-expanded', 'false');
        }, 150);
      }

      dropdown.addEventListener('mouseenter', show);
      dropdown.addEventListener('mouseleave', hide);
      dropdown.addEventListener('focusin', show);
      dropdown.addEventListener('focusout', (e) => {
        if (!dropdown.contains((e as FocusEvent).relatedTarget as Node)) {
          hide();
        }
      });
    });

    // Search modal
    const searchBtn = document.getElementById('search-btn');
    const searchModal = document.getElementById('search-modal');
    const searchBackdrop = document.getElementById('search-backdrop');

    function openSearch() {
      searchModal?.classList.remove('hidden');
      setTimeout(() => {
        const input = searchModal?.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        input?.focus();
      }, 50);
    }

    // ONI easter egg: typing "oni" in search triggers the CTF
    function watchForOni() {
      const searchContainer = document.getElementById('search-container');
      if (!searchContainer) return;
      const observer = new MutationObserver(() => {
        const input = searchContainer.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        if (!input || input.dataset.oniWatched) return;
        input.dataset.oniWatched = 'true';
        input.addEventListener('input', () => {
          const val = input.value.trim().toLowerCase();
          if (val === 'oni' || val === 'kulhi' || val === 'kulhi loach' || val === 'kulhi loaches' || val === 'keviano') {
            // Trigger the CTF via the BCI Vision toggle
            closeSearch();
            setTimeout(() => {
              document.documentElement.classList.add('crt-flicker');
              setTimeout(() => {
                document.documentElement.classList.remove('crt-flicker');
                // Dispatch a custom event that BciVisionToggle listens for
                window.dispatchEvent(new CustomEvent('oni-trigger', { detail: val }));
              }, 300);
            }, 200);
          }
        });
      });
      observer.observe(searchContainer, { childList: true, subtree: true });
    }
    watchForOni();

    function closeSearch() {
      searchModal?.classList.add('hidden');
    }

    searchBtn?.addEventListener('click', openSearch);
    searchBackdrop?.addEventListener('click', closeSearch);

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        if (searchModal?.classList.contains('hidden')) {
          openSearch();
        } else {
          closeSearch();
        }
      }
      if (e.key === 'Escape') {
        closeSearch();
      }
    });

    document.addEventListener('astro:before-swap', closeSearch);
  }

  initNav();
  document.addEventListener('astro:after-swap', initNav);
</script>

<style>
  /* Measured from the Starcloud reference (2x captures): 36px pills, full radius,
     40px gaps between links, 20px inner padding. Tint is black at ~30% on light
     and ~45% on dark; links are white at ~68%, the active link pure white. */
  .nav-root { --nav-tint: rgba(0, 0, 0, 0.45); --nav-text: rgba(255, 255, 255, 0.68); }
  :root[data-theme="light"] .nav-root { --nav-tint: rgba(0, 0, 0, 0.3); }
  .nav-logo { display: block; width: 28px; height: 28px; }
  /* Bar sits above the mobile sheet so the logo and the menu button stay usable while it is open. */
  .nav-bar-row { position: relative; z-index: 1; }
  /* Mobile sheet: solid black, opens as a circle growing out of the menu button (top right). */
  .mobile-sheet { position: fixed; inset: 0; z-index: 0; background: #000; pointer-events: auto; }
  .mobile-sheet:not(.hidden) {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
    padding: 6rem 1.5rem 3rem;
    animation: mobile-sheet-open 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  @keyframes mobile-sheet-open {
    from { clip-path: circle(0px at calc(100% - 34px) 34px); }
    to { clip-path: circle(150vmax at calc(100% - 34px) 34px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-sheet:not(.hidden) { animation: none; }
  }
  @media (min-width: 1024px) {
    .mobile-sheet { display: none !important; }
  }
  .mobile-sheet-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; align-items: center; gap: 0.5rem; }
  .mobile-sheet-link { display: block; padding: 0.6rem 1.25rem; border-radius: 1rem; font-size: 1.5rem; font-weight: 500; color: rgba(255, 255, 255, 0.7); text-align: center; transition: color 0.2s ease; }
  .mobile-sheet-link:hover { color: #ffffff; }
  .mobile-sheet-cta { margin-top: 1rem; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; height: 2.75rem; padding: 0 1.5rem; border-radius: 9999px; font-size: 1rem; }
  .nav-pill, .nav-cta, .nav-round {
    background: var(--nav-tint);
    backdrop-filter: blur(14px) saturate(110%);
    -webkit-backdrop-filter: blur(14px) saturate(110%);
    color: var(--nav-text);
  }
  .nav-link { font-size: 16px; line-height: 1; color: var(--nav-text); transition: color 0.2s ease; }
  .nav-link:hover, .nav-link-active { color: #ffffff; }
  /* Selected item: a glass box with a soft white glow, no accent colour. */
  .nav-item-active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 1px rgba(251, 191, 36, 0.4), 0 0 18px rgba(251, 191, 36, 0.14);
  }
  .nav-cta { font-size: 16px; line-height: 1; color: #ffffff; transition: transform 0.25s ease, box-shadow 0.25s ease; }
  /* Inside the mobile panel (which is already glass) the pill needs its own lighter sheen to read as a button. */
  .nav-cta-menu { background: rgba(255, 255, 255, 0.12); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.18); }
  .nav-cta:hover { transform: translateY(-1px); box-shadow: 0 4px 14px -8px rgba(14, 165, 233, 0.35); }
  .nav-round { display: inline-flex; align-items: center; justify-content: center; width: 36px; height: 36px; border-radius: 9999px; transition: color 0.2s ease; pointer-events: auto; }
  .nav-round:hover { color: #ffffff; }
  @media (prefers-reduced-transparency: reduce) { .nav-pill, .nav-cta, .nav-round { background: #15151c; } }
</style>
