---
import Search from 'astro-pagefind/components/Search';
import ThemeToggle from './ThemeToggle.astro';
import { TARA_TECHNIQUES } from '../lib/qif-constants';

const currentPath = Astro.url.pathname;

// --- Nav structure: sections > groups > links ---
interface NavLink { href: string; label: string; desc?: string }
interface NavGroup { title: string; links: NavLink[] }
interface NavSection { id: string; label: string; href: string; groups: NavGroup[]; isActive?: boolean }

const missionGroups: NavGroup[] = [
  {
    title: 'About',
    links: [
      { href: '/mission/', label: 'Mission Statement', desc: 'Unified model for BCI risk, equity, and informed consent' },
      { href: '/news/roadmap/', label: 'Roadmap', desc: 'Milestones and version history' },
    ],
  },
  {
    title: 'Governance',
    links: [
      { href: '/research/neuroethics-landscape/', label: 'Neuroethics Landscape', desc: 'Modern timeline of neuroethics scholarship' },
      { href: '/governance/rights/', label: 'Neurorights', desc: '5 proposed neurorights mapped to hourglass bands' },
      { href: '/governance/ai-security-ethics/', label: 'AI Ethics', desc: 'Principles, frameworks, and regulatory landscape' },
      { href: '/governance/', label: 'Code of Ethics', desc: 'Ethical commitments and conduct standards' },
    ],
  },
];

const atlasGroups: NavGroup[] = [
  {
    title: 'Framework',
    links: [
      { href: '/atlas/clinical/', label: 'Clinical', desc: 'DSM-5 mappings, therapeutic analogs, device safety' },
      { href: '/atlas/', label: 'Atlas Dashboard', desc: 'Unified hourglass, brain, and threat landscape' },
      { href: '/framework/', label: 'QIF Framework', desc: '11-band hourglass architecture' },
      { href: '/atlas/tara/', label: 'TARA Catalog', desc: `${TARA_TECHNIQUES} techniques scored with NISS` },
      { href: '/atlas/scoring/', label: 'NISS Scoring', desc: 'Neural Impact Scoring — extending CVSS' },
    ],
  },
  {
    title: 'Analysis',
    links: [
      { href: '/atlas/tara/ttps/', label: 'Threat Matrix', desc: 'Tactics, techniques & procedures' },
      { href: '/atlas/tara/numbering/', label: 'QIF Numbering', desc: 'Technique IDs and tactic codes' },
      { href: '/atlas/analysis/', label: 'Case Studies', desc: 'Deep dives and attack chain analysis' },
      { href: '/research/bci-explorer/', label: 'BCI Explorer', desc: 'Interactive device and threat map' },
    ],
  },
  {
    title: 'Tools',
    links: [
      { href: '/tools/', label: 'Tools & Plugins', desc: 'Open-source security tools and AI plugins' },
      { href: '/tools/intel/', label: 'Intel & APIs', desc: 'STIX 2.1, TAXII feed, Python SDK, 74+ sources' },
      { href: '/research/data-lake/', label: 'Data Lake Dashboard', desc: 'Live metrics across all QIF data sources' },
    ],
  },
];

const rndGroups: NavGroup[] = [
  {
    title: 'Research',
    links: [
      { href: '/research/', label: 'Overview', desc: 'All research areas and methodology' },
      { href: '/research/whitepaper/', label: 'Whitepaper', desc: 'Latest QIF specification' },
      { href: '/research/landscape/', label: 'BCI Landscape', desc: 'Market analysis and device landscape' },
      { href: '/atlas/clinical/', label: 'Clinical', desc: 'DSM-5 mappings & therapeutic analogs' },
    ],
  },
  {
    title: 'Neurosecurity Stack',
    links: [
      { href: '/development/', label: 'Overview', desc: 'Proposed neurosecurity stack for neural interfaces' },
      { href: '/guardrails/', label: 'Neurowall', desc: 'Signal-layer firewall at I0' },
      { href: '/guardrails/nsp/', label: 'NSP Protocol', desc: 'Post-quantum wire security' },
      { href: '/guardrails/runemate/', label: 'Runemate', desc: 'On-device policy compiler' },
    ],
  },
  {
    title: 'Updates',
    links: [
      { href: '/news/', label: 'Blog & Field Journals', desc: 'Announcements and research notes' },
      { href: '/news/derivation/', label: 'Derivation Log', desc: 'Live research journal' },
      { href: '/research/validation/', label: 'Validation', desc: 'Methodology and testing results' },
      { href: '/research/intel/', label: 'BCI Intel Reports', desc: 'Quarterly threat intelligence publications' },
    ],
  },
];

const isMissionActive = ['/mission/'].some(p => currentPath.startsWith(p))
  || currentPath.startsWith('/governance/') || currentPath === '/news/roadmap/';
const isAtlasActive = currentPath.startsWith('/atlas/') || currentPath.startsWith('/framework/')
  || currentPath.startsWith('/security/') || currentPath.startsWith('/tools/')
;
const isRndActive = currentPath.startsWith('/research/') || currentPath.startsWith('/development/')
  || currentPath.startsWith('/guardrails/') || (currentPath.startsWith('/news/') && !currentPath.startsWith('/news/roadmap/'));

const navSections: NavSection[] = [
  { id: 'mission', label: 'Mission', href: '/mission/', groups: missionGroups, isActive: isMissionActive },
  { id: 'atlas', label: 'Atlas', href: '/atlas/', groups: atlasGroups, isActive: isAtlasActive },
  { id: 'rnd', label: 'R&D', href: '/research/', groups: rndGroups, isActive: isRndActive },
];
---

<nav class="glass fixed top-0 left-0 right-0 z-50 border-b border-[var(--color-border)]" id="main-nav" transition:persist>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
        <span class="text-2xl font-bold font-[family-name:var(--font-heading)] bg-gradient-to-r from-[var(--color-accent-primary)] via-[var(--color-accent-secondary)] to-[var(--color-accent-tertiary)] bg-clip-text text-transparent">Q</span>
        <span class="text-sm font-medium tracking-wider uppercase hidden sm:inline text-[var(--color-text-primary)]">innovate</span>
        <span class="text-xs text-[var(--color-text-faint)] hidden sm:inline ml-1">|</span>
        <span class="text-xs font-medium tracking-wide hidden sm:inline text-[var(--color-text-muted)]">Open Neural Atlas</span>
      </a>

      <!-- Desktop links -->
      <div class="hidden lg:flex items-center gap-0.5">
        {navSections.map((section) => (
          <div class="relative" data-dropdown={section.id}>
            <a
              href={section.href}
              aria-expanded="false"
              class:list={[
                "flex items-center gap-1 px-2.5 py-2 rounded-lg text-sm font-medium transition-colors",
                section.isActive
                  ? "text-[var(--color-accent-primary)] bg-[var(--color-accent-primary)]/10"
                  : "text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-black/5"
              ]}
            >
              {section.label}
              <svg class="w-3 h-3 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
              </svg>
            </a>
            <div class="dropdown-menu absolute left-0 top-full pt-2 hidden">
              <div class="glass nav-dropdown rounded-xl border border-[var(--color-border)] shadow-xl overflow-hidden max-h-[75vh] overflow-y-auto"
                style={`width: ${section.groups.length > 2 ? '640px' : '420px'};`}
              >
                <div class={`p-3 ${section.groups.length > 2 ? 'grid grid-cols-3 gap-3' : section.groups.length === 2 ? 'grid grid-cols-2 gap-3' : ''}`}>
                  {section.groups.map((group) => (
                    <div>
                      <p class="text-[10px] font-semibold uppercase tracking-[0.12em] px-2 py-1.5 mb-1" style="color: var(--color-text-faint);">
                        {group.title}
                      </p>
                      {group.links.map((link) => (
                        <a
                          href={link.href}
                          class:list={[
                            "block px-2 py-2 rounded-lg transition-colors",
                            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                              ? "text-[var(--color-accent-primary)] bg-[var(--color-accent-primary)]/10"
                              : "text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-black/5"
                          ]}
                        >
                          <span class="text-sm font-medium block leading-snug">{link.label}</span>
                          {link.desc && (
                            <span class="text-[11px] block mt-0.5 leading-snug" style="color: var(--color-text-faint);">{link.desc}</span>
                          )}
                        </a>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Right side -->
      <div class="flex items-center gap-2">
        <ThemeToggle />

        <!-- Explore Atlas CTA (desktop) -->
        <a
          href="/atlas/"
          class:list={[
            "hidden md:inline-flex items-center gap-1.5 px-4 py-1.5 rounded-lg text-sm font-medium transition-colors",
            currentPath.startsWith('/atlas')
              ? "bg-[var(--color-accent-secondary)] text-white"
              : "bg-[var(--color-accent-secondary)]/85 text-white hover:bg-[var(--color-accent-secondary)]"
          ]}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 32 32" fill="none">
            <path d="M8 16 Q12 8 16 16 Q20 24 24 16" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <circle cx="16" cy="16" r="2.5" fill="currentColor"/>
          </svg>
          Neural Atlas
        </a>

        <!-- Persistent CTA (desktop) -->
        <a
          href="/research/whitepaper/"
          class="hidden md:inline-flex px-4 py-1.5 rounded-lg bg-[var(--color-accent-primary)] text-white text-sm font-medium hover:bg-[var(--color-accent-primary)]/90 transition-colors"
        >
          Whitepaper
        </a>

        <!-- GitHub link -->
        <a
          href="https://github.com/qinnovates/neurosecurity"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-black/5 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>

        <!-- Search button -->
        <button
          id="search-btn"
          class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-black/5 transition-colors"
          aria-label="Search"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        </button>

        <!-- Mobile menu button -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden inline-flex items-center justify-center min-w-[44px] min-h-[44px] rounded-lg text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)] hover:bg-black/5 transition-colors"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden border-t border-[var(--color-border)] max-h-[80vh] overflow-y-auto bg-[var(--color-bg-deep)]"
    role="dialog"
    aria-modal="true"
    aria-label="Main navigation"
  >
    <div class="px-4 py-3 space-y-1">
      <!-- Mobile CTAs -->
      <div class="pb-2 mb-2 border-b border-[var(--color-border)] space-y-2">
        <a
          href="/atlas/"
          class="flex items-center justify-center gap-2 w-full px-4 py-2.5 rounded-lg bg-[var(--color-accent-secondary)] text-white text-sm font-medium text-center hover:bg-[var(--color-accent-secondary)]/90 transition-colors"
        >
          <svg class="w-4 h-4" viewBox="0 0 32 32" fill="none">
            <path d="M8 16 Q12 8 16 16 Q20 24 24 16" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            <circle cx="16" cy="16" r="2.5" fill="currentColor"/>
          </svg>
          Neural Atlas
        </a>
        <a
          href="/research/whitepaper/"
          class="block w-full px-4 py-2.5 rounded-lg bg-[var(--color-accent-primary)] text-white text-sm font-medium text-center hover:bg-[var(--color-accent-primary)]/90 transition-colors"
        >
          Read the Whitepaper
        </a>
      </div>

      <!-- Mobile nav sections with nested groups -->
      {navSections.map((section) => (
        <div class="border-t border-[var(--color-border)] pt-1 mt-1">
          <button
            data-mobile-toggle={section.id}
            class:list={[
              "flex items-center justify-between w-full px-3 py-2 rounded-lg text-sm font-semibold transition-colors",
              section.isActive
                ? "text-[var(--color-accent-primary)] bg-[var(--color-accent-primary)]/10"
                : "text-[var(--color-text-primary)] hover:bg-black/5"
            ]}
          >
            {section.label}
            <svg class="w-3.5 h-3.5 opacity-60 transition-transform" data-chevron={section.id} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
            </svg>
          </button>

          <div data-mobile-list={section.id} class="hidden mt-1 space-y-1">
            {section.groups.map((group) => (
              <div class="ml-2">
                <button
                  data-mobile-group={`${section.id}-${group.title.toLowerCase().replace(/\s+/g, '-')}`}
                  class="flex items-center justify-between w-full px-3 py-1.5 text-[11px] font-semibold uppercase tracking-[0.1em] rounded-lg transition-colors hover:bg-black/5"
                  style="color: var(--color-text-faint);"
                >
                  {group.title}
                  <svg class="w-3 h-3 opacity-50 transition-transform" data-group-chevron={`${section.id}-${group.title.toLowerCase().replace(/\s+/g, '-')}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                  </svg>
                </button>
                <div data-mobile-group-list={`${section.id}-${group.title.toLowerCase().replace(/\s+/g, '-')}`} class="hidden ml-2 space-y-0.5 mt-0.5 mb-1">
                  {group.links.map((link) => (
                    <a
                      href={link.href}
                      class:list={[
                        "block px-3 py-1.5 rounded-lg text-sm transition-colors",
                        currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
                          ? "text-[var(--color-accent-primary)] bg-[var(--color-accent-primary)]/5"
                          : "text-[var(--color-text-muted)] hover:text-[var(--color-text-primary)]"
                      ]}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</nav>

<!-- Search modal -->
<div id="search-modal" class="fixed inset-0 z-[100] hidden" role="dialog" aria-modal="true" aria-label="Site search">
  <div id="search-backdrop" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="relative max-w-2xl mx-auto mt-20 px-4">
    <div class="glass rounded-xl p-4 shadow-2xl" id="search-container">
      <Search id="search" className="pagefind-ui" uiOptions={{ showImages: false, showSubResults: true }} />
    </div>
  </div>
</div>

<script>
  // Nav lives under `transition:persist`, so the DOM element survives SPA
  // navigations. Re-running per-swap init would accumulate duplicate listeners
  // and leak MutationObservers. Instead:
  //   - Document-level click/keydown delegation: attach ONCE at module scope.
  //   - Per-element hover bindings (desktop dropdowns): dataset-guarded so
  //     each element is bound at most once.
  //   - MutationObserver: explicitly disconnect the previous one on re-init.
  (function initNavOnce() {
    const MENU_OPEN_CLASS = 'nav-menu-open';
    let oniObserver: MutationObserver | null = null;
    let focusBeforeMenu: HTMLElement | null = null;

    function $(id: string): HTMLElement | null {
      return document.getElementById(id);
    }

    function setMenuOpen(open: boolean): void {
      const menu = $('mobile-menu');
      const btn = $('mobile-menu-btn');
      if (!menu || !btn) return;
      menu.classList.toggle('hidden', !open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.classList.toggle(MENU_OPEN_CLASS, open);
      if (open) {
        focusBeforeMenu = (document.activeElement as HTMLElement) ?? null;
        const firstFocusable = menu.querySelector<HTMLElement>('a, button, [tabindex]:not([tabindex="-1"])');
        firstFocusable?.focus();
      } else if (focusBeforeMenu) {
        focusBeforeMenu.focus();
        focusBeforeMenu = null;
      }
    }

    function toggleMenu(): void {
      const menu = $('mobile-menu');
      if (!menu) return;
      setMenuOpen(menu.classList.contains('hidden'));
    }

    function closeMenu(): void { setMenuOpen(false); }

    function openSearch(): void {
      const modal = $('search-modal');
      modal?.classList.remove('hidden');
      setTimeout(() => {
        modal?.querySelector<HTMLInputElement>('.pagefind-ui__search-input')?.focus();
      }, 50);
    }

    function closeSearch(): void {
      $('search-modal')?.classList.add('hidden');
    }

    function toggleAccordion(key: string | null): void {
      if (!key) return;
      document.querySelector(`[data-mobile-list="${key}"]`)?.classList.toggle('hidden');
      document.querySelector(`[data-chevron="${key}"]`)?.classList.toggle('rotate-180');
    }

    function toggleGroupAccordion(key: string | null): void {
      if (!key) return;
      document.querySelector(`[data-mobile-group-list="${key}"]`)?.classList.toggle('hidden');
      document.querySelector(`[data-group-chevron="${key}"]`)?.classList.toggle('rotate-90');
    }

    // ── Delegated click ────────────────────────────────────────────────
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof Element)) return;

      if (t.closest('#mobile-menu-btn')) { toggleMenu(); return; }
      if (t.closest('#search-btn')) { openSearch(); return; }
      if (t.closest('#search-backdrop')) { closeSearch(); return; }

      const mobileToggle = t.closest<HTMLElement>('[data-mobile-toggle]');
      if (mobileToggle) {
        toggleAccordion(mobileToggle.getAttribute('data-mobile-toggle'));
        return;
      }

      const groupToggle = t.closest<HTMLElement>('[data-mobile-group]');
      if (groupToggle) {
        toggleGroupAccordion(groupToggle.getAttribute('data-mobile-group'));
        return;
      }

      // Tapping a link inside the open mobile menu should close the menu
      if (t.closest('#mobile-menu a[href]')) closeMenu();
    });

    // ── Delegated keydown ──────────────────────────────────────────────
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const modal = $('search-modal');
        if (modal?.classList.contains('hidden')) openSearch();
        else closeSearch();
        return;
      }
      if (e.key === 'Escape') {
        closeSearch();
        closeMenu();
      }
    });

    // ── SPA lifecycle: register ONCE ───────────────────────────────────
    document.addEventListener('astro:before-swap', () => {
      closeSearch();
      closeMenu();
    });

    // ── Per-element hover bindings (idempotent) ────────────────────────
    function bindDropdowns(): void {
      document.querySelectorAll<HTMLElement>('[data-dropdown]').forEach((dropdown) => {
        if (dropdown.dataset.navBound === '1') return;
        dropdown.dataset.navBound = '1';

        const menu = dropdown.querySelector<HTMLElement>('.dropdown-menu');
        const trigger = dropdown.querySelector<HTMLElement>('a[aria-expanded]');
        let timeout: ReturnType<typeof setTimeout>;

        const show = () => {
          document.querySelectorAll<HTMLElement>('.dropdown-menu').forEach(m => {
            if (m !== menu) m.classList.add('hidden');
          });
          document.querySelectorAll<HTMLElement>('[data-dropdown] a[aria-expanded]').forEach(t => {
            if (t !== trigger) t.setAttribute('aria-expanded', 'false');
          });
          clearTimeout(timeout);
          menu?.classList.remove('hidden');
          trigger?.setAttribute('aria-expanded', 'true');
        };

        const hide = () => {
          timeout = setTimeout(() => {
            menu?.classList.add('hidden');
            trigger?.setAttribute('aria-expanded', 'false');
          }, 150);
        };

        dropdown.addEventListener('mouseenter', show);
        dropdown.addEventListener('mouseleave', hide);
        dropdown.addEventListener('focusin', show);
        dropdown.addEventListener('focusout', (ev) => {
          if (!dropdown.contains((ev as FocusEvent).relatedTarget as Node)) hide();
        });
      });
    }

    // ── ONI easter egg: replace observer, never accumulate ─────────────
    function watchForOni(): void {
      oniObserver?.disconnect();
      oniObserver = null;

      const searchContainer = $('search-container');
      if (!searchContainer) return;

      oniObserver = new MutationObserver(() => {
        const input = searchContainer.querySelector<HTMLInputElement>('.pagefind-ui__search-input');
        if (!input || input.dataset.oniWatched) return;
        input.dataset.oniWatched = 'true';
        input.addEventListener('input', () => {
          const val = input.value.trim().toLowerCase();
          if (['oni', 'kulhi', 'kulhi loach', 'kulhi loaches', 'keviano'].includes(val)) {
            closeSearch();
            setTimeout(() => {
              document.documentElement.classList.add('crt-flicker');
              setTimeout(() => {
                document.documentElement.classList.remove('crt-flicker');
                window.dispatchEvent(new CustomEvent('oni-trigger', { detail: val }));
              }, 300);
            }, 200);
          }
        });
      });
      oniObserver.observe(searchContainer, { childList: true, subtree: true });
    }

    function initPerElement(): void {
      bindDropdowns();
      watchForOni();
    }

    initPerElement();
    document.addEventListener('astro:after-swap', initPerElement);
  })();
</script>

<style is:global>
  /* Lock body scroll while mobile menu is open (iOS Safari-safe) */
  body.nav-menu-open {
    overflow: hidden;
    touch-action: none;
  }
</style>
