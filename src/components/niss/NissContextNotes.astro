---
/**
 * NissContextNotes — the context a NISS score needs to be read correctly,
 * shown beside the score and never folded into it (2026-10-16 review):
 *   - the technique's evidence tier, so a theoretical score is not read as a
 *     demonstrated one;
 *   - the harm flag, because the weighted mean can average critical
 *     biological impact down to a low score;
 *   - the cognitive flag, because CR and CD carry half weight;
 *   - the NP:S support note on theoretical and speculative techniques;
 *   - where the severity label came from, and the label it replaced;
 *   - the neural-impact scope: NISS measures impact on the nervous system, so a
 *     technique with no biological effect (BI:N) reads low by construction.
 */
import { EVIDENCE_TIER_LABELS, type EvidenceTierCode } from '../../lib/evidence-tiers';
import type { NissScore, Severity, SeveritySource } from '../../lib/threat-data';

interface Props {
  niss: NissScore;
  evidenceTier: EvidenceTierCode;
  severitySource: SeveritySource;
  severityLegacy: Severity | null;
}

const { niss, evidenceTier, severitySource, severityLegacy } = Astro.props;
const tierLabel = EVIDENCE_TIER_LABELS[evidenceTier] ?? evidenceTier;
const hasNoBiologicalImpact = niss.vector.includes('/BI:N');
const relabelled = severitySource === 'niss' && severityLegacy !== null && severityLegacy !== niss.severity;
---

<ul class="mt-3 space-y-1.5 text-xs text-[var(--color-text-muted)]" aria-label="How to read this score">
  <li>
    <span class="font-semibold text-[var(--color-text-secondary)]">Evidence:</span> {tierLabel}
  </li>
  {niss.harm_flag && (
    <li class="text-red-400">
      <span aria-hidden="true">⚠</span>
      <span class="font-semibold">Harm flag:</span> biological impact is rated high or critical. The weighted
      score can average this down; read the BI metric, not only the total.
    </li>
  )}
  {niss.cognitive_flag && (
    <li class="text-amber-400">
      <span aria-hidden="true">⚠</span>
      <span class="font-semibold">Cognitive flag:</span> cognitive reconnaissance or disruption is rated high or
      critical. These metrics carry half weight in the total; read them directly.
    </li>
  )}
  {niss.np_support === 'unsupported' && (
    <li>
      <span class="font-semibold text-[var(--color-text-secondary)]">Neuroplasticity:</span> the "structural"
      rating is not supported by demonstrated evidence for this technique. The score is unchanged.
    </li>
  )}
  {hasNoBiologicalImpact && (
    <li>
      <span class="font-semibold text-[var(--color-text-secondary)]">Scope:</span> NISS measures impact on the
      nervous system only. This technique has no direct biological effect, so its NISS severity understates its
      classical severity; read the CVSS vector for that.
    </li>
  )}
  <li>
    <span class="font-semibold text-[var(--color-text-secondary)]">Neural-impact severity (NISS):</span>
    {severitySource === 'niss' ? 'derived from the NISS score' : 'editorial; this technique has no NISS score yet'}
    {relabelled && <span> (previously rated {severityLegacy})</span>}
  </li>
</ul>
