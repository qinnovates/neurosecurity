---
// Astro 6: ViewTransitions removed; use ClientRouter component instead.
import { ClientRouter } from 'astro:transitions';
import { SITE_PAGE_CSP, joinPolicy } from '../lib/csp-policy';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  articleMeta?: { publishedTime: string; author: string; tags: string[] };
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description = "Quantum Indeterministic Framework for Brain-Computer Interface Security", ogImage, ogType = "website", articleMeta, breadcrumbs } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const resolvedOgImage = ogImage || new URL('/images/og-default.png', Astro.site).toString();

// Vite's dev server needs a websocket for hot reload, which the policy blocks, so it applies to built pages only.
const isBuiltPage = import.meta.env.PROD;
// A preview build is never indexed; the flag is server-side only (not PUBLIC_), read at build time.
const isPreviewBuild = process.env.QINNOVATE_PREVIEW === '1';
// Dark is the site default. The pre-paint script only honours a stored choice; it never asks the system.
const DEFAULT_THEME = 'dark';
---

<!DOCTYPE html>
<html lang="en-US" data-theme={DEFAULT_THEME}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  {/* The one policy this page states. GitHub Pages sends no header, so this meta is the whole policy in production. */}
  {isBuiltPage && <meta http-equiv="Content-Security-Policy" content={joinPolicy(SITE_PAGE_CSP)} />}
  <meta name="referrer" content="strict-origin-when-cross-origin" />
  {isPreviewBuild && <meta name="robots" content="noindex, nofollow" />}
  <meta name="description" content={description} />
  <meta name="author" content="Kevin L. Qi" />
  <link rel="canonical" href={canonicalURL} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90' font-family='system-ui' fill='%2306b6d4'%3EQ%3C/text%3E%3C/svg%3E" />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="Qinnovate" />
  <meta property="og:type" content={ogType} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content="en_US" />
  {articleMeta && <meta property="article:published_time" content={articleMeta.publishedTime} />}
  {articleMeta && <meta property="article:author" content={articleMeta.author} />}
  {articleMeta?.tags.map((tag) => <meta property="article:tag" content={tag} />)}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={resolvedOgImage} />
  <meta name="twitter:creator" content="@qikevinl" />

  <!-- JSON-LD Structured Data (escape </script> to prevent injection) -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Qinnovate",
    "url": "https://qinnovate.com",
    "description": "Open research on brain-computer interface security and governance.",
    "foundingDate": "2026",
    "sameAs": ["https://github.com/qinnovates"]
  }).replace(/<\//g, '<\\/')} />

  <!-- WebSite schema with SearchAction for sitelinks search box -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Qinnovate",
    "url": "https://qinnovate.com",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://qinnovate.com/?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }).replace(/<\//g, '<\\/')} />

  {breadcrumbs && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": new URL('/', Astro.site).toString() },
        ...breadcrumbs.map((crumb, i) => ({
          "@type": "ListItem",
          "position": i + 2,
          "name": crumb.label,
          ...(crumb.href ? { "item": new URL(crumb.href, Astro.site).toString() } : {}),
        })),
      ],
    }).replace(/<\//g, '<\\/')} />
  )}

  <!-- Consent for optional analytics: loads nothing from a third party until the visitor accepts -->
  <script is:inline type="module" src="/js/consent.js"></script>

  <!-- RSS autodiscovery -->
  <link rel="alternate" type="application/rss+xml" title="Qinnovate Intel" href="/rss.xml" />

  <title>{title} | Qinnovate</title>

  <!-- Additional head content from child layouts -->
  <slot name="head" />

  <!-- View Transitions (Astro 6: ClientRouter replaces ViewTransitions) -->
  <ClientRouter />


  <!-- Theme + Vision mode + Lens initialization (prevent flash) -->
  <!-- data-astro-rerun: ClientRouter replaces <html>'s attributes on swap and dedupes
       identical inline scripts, so without this the saved theme is lost on every
       client-side navigation and the page reverts to the default theme. -->
  <script is:inline data-astro-rerun define:vars={{ defaultTheme: DEFAULT_THEME }}>
    (function(){
      try {
        var path = window.location.pathname;
        var isVisionPage = path.startsWith('/vision');
        var vision = isVisionPage && localStorage.getItem('bci-vision') === 'on';
        // Theme: vision pages force dark when vision is on; otherwise a stored choice, else the default.
        // The system preference is deliberately not read, so the attribute never changes between SSR and first paint.
        var savedTheme = localStorage.getItem('theme');
        var theme = vision ? 'dark' : (savedTheme || defaultTheme);
        document.documentElement.setAttribute('data-theme', theme);
        document.documentElement.setAttribute('data-vision', vision ? 'on' : 'off');
        // Shown inside TARA Lab's frame: the page hides its own navigation and footer.
        if (window.self !== window.top) document.documentElement.setAttribute('data-embedded', 'true');
        var lens = localStorage.getItem('qif-lens') || 'both';
        document.documentElement.setAttribute('data-lens', lens);
      } catch(e) {
        document.documentElement.setAttribute('data-theme', defaultTheme);
        document.documentElement.setAttribute('data-vision', 'off');
        document.documentElement.setAttribute('data-lens', 'both');
      }
    })();
  </script>
</head>
<body class="min-h-screen">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-lg focus:bg-[var(--color-accent-fill)] focus:text-white focus:text-sm focus:font-bold">Skip to content</a>
  <main id="main-content">
    <slot />
  </main>

  <!-- Scroll-driven reveal observer -->
  <script>
    function initScrollReveal() {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach((el) => observer.observe(el));
    }

    initScrollReveal();
    document.addEventListener('astro:after-swap', initScrollReveal);
  </script>
</body>
</html>
