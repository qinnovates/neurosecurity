---
// Bare layout for tools that handle a visitor's own device details.
// It deliberately omits what BaseLayout loads: the soft-navigation router and
// third-party analytics. src/scripts/check-model-page.mjs enforces this on the built page.
import '../styles/global.css';
import { TOOL_PAGE_CSP, joinPolicy } from '../lib/csp-policy';

type ThemeName = 'dark' | 'light';

interface Props {
  title: string;
  description: string;
  /** True when the page brings its own full-width frame, so the layout adds no header or margins. */
  isAppShell?: boolean;
  /** True for a launched page search engines may list. A review draft or a framed tool stays out. */
  indexable?: boolean;
  /** The theme rendered on the server and used when the visitor has stored no choice. */
  theme?: ThemeName;
}

const { title, description, isAppShell = false, indexable = false, theme = 'dark' } = Astro.props;

// Vite's dev server needs a websocket for hot reload, which this policy blocks,
// so the policy is applied to built pages only.
const isBuiltPage = import.meta.env.PROD;
// A preview build is never indexed, whatever the page asks; the flag is server-side only.
const isPreviewBuild = process.env.QINNOVATE_PREVIEW === '1';
const isNoindex = !indexable || isPreviewBuild;
---

<!DOCTYPE html>
<html lang="en-US" data-theme={theme}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="description" content={description} />
  {isNoindex && <meta name="robots" content="noindex, nofollow" />}
  {isBuiltPage && <meta http-equiv="Content-Security-Policy" content={joinPolicy(TOOL_PAGE_CSP)} />}
  <meta name="referrer" content="no-referrer" />
  <title>{title} | Qinnovate</title>

  <!-- Match the site theme without the shared layout (prevents a flash) -->
  <script is:inline>
    // This host cannot send a frame-ancestors header, so the page leaves any frame another site puts it in.
    (function () {
      if (window.top === window.self) return;
      try {
        void window.top.location.origin;
      } catch (crossOriginFrame) {
        window.top.location = window.self.location.href;
      }
    })();
  </script>
  <script is:inline define:vars={{ defaultTheme: theme }}>
    (function () {
      // A stored choice wins; otherwise the server-rendered theme stays, so the attribute never changes before first paint.
      var resolved = defaultTheme;
      try {
        resolved = localStorage.getItem('theme') || defaultTheme;
      } catch (storageError) {
        // Storage can be blocked by browser settings; the rendered theme is the safe default.
        resolved = defaultTheme;
      }
      document.documentElement.setAttribute('data-theme', resolved);
    })();
  </script>
</head>
<body class="min-h-screen" data-pagefind-ignore>
  {/* An app shell brings its own skip link: its address holds the screen, so a link to "#main-content" would change the screen. */}
  {!isAppShell && <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-[200] focus:px-4 focus:py-2 focus:rounded-lg" style="background: var(--color-bg-surface); color: var(--color-text-primary); border: 1px solid var(--color-accent-primary)">Skip to content</a>}
  {!isAppShell && <header class="tool-header px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl pt-6 flex items-center justify-between gap-4">
    <a href="/atlas/tara/" class="text-sm font-medium" style="color: var(--color-accent-primary)">&larr; Back to the site</a>
    <span class="text-xs" style="color: var(--color-text-muted)">Runs in your browser. Nothing you enter is sent anywhere.</span>
  </header>}
  <main id="main-content" class={isAppShell ? undefined : 'px-4 sm:px-6 lg:px-8 mx-auto max-w-7xl py-8'}>
    <slot />
  </main>
</body>
</html>
